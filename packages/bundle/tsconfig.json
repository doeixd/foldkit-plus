{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": ".tsbuild",
    "emitDeclarationOnly": true,
    "composite": true,
    "noEmit": false,
    "paths": {
      "@doeixd/metakit": ["../metakit/src/index.ts"],
      "@doeixd/metakit/aggregates": ["../metakit/src/aggregates.ts"],
      "@doeixd/metakit/aggregates/sql": ["../metakit/src/aggregatesSql.ts"],
      "@doeixd/metakit/artifact": ["../metakit/src/artifact.ts"],
      "@doeixd/metakit/build": ["../metakit/src/build.ts"],
      "@doeixd/metakit/conformance": ["../metakit/src/conformance.ts"],
      "@doeixd/metakit/domain": ["../metakit/src/domain.ts"],
      "@doeixd/metakit/drizzle": ["../metakit/src/drizzle.ts"],
      "@doeixd/metakit/fn": ["../metakit/src/fn.ts"],
      "@doeixd/metakit/graph": ["../metakit/src/graph.ts"],
      "@doeixd/metakit/graph/match": ["../metakit/src/graph/match.ts"],
      "@doeixd/metakit/graph/prune": ["../metakit/src/graph/prune.ts"],
      "@doeixd/metakit/graph/readiness": ["../metakit/src/graph/readiness.ts"],
      "@doeixd/metakit/inspect": ["../metakit/src/inspect.ts"],
      "@doeixd/metakit/interpreter": ["../metakit/src/interpreter.ts"],
      "@doeixd/metakit/language": ["../metakit/src/language.ts"],
      "@doeixd/metakit/machine": ["../metakit/src/machine.ts"],
      "@doeixd/metakit/operation": ["../metakit/src/operation.ts"],
      "@doeixd/metakit/operation/sql": ["../metakit/src/operationSql.ts"],
      "@doeixd/metakit/pairs": ["../metakit/src/pairs.ts"],
      "@doeixd/metakit/policy": ["../metakit/src/policy.ts"],
      "@doeixd/metakit/prove": ["../metakit/src/prove.ts"],
      "@doeixd/metakit/relation": ["../metakit/src/relation.ts"],
      "@doeixd/metakit/sql": ["../metakit/src/sql.ts"],
      "@doeixd/metakit/store": ["../metakit/src/store.ts"],
      "@doeixd/metakit/store/check": ["../metakit/src/storeCheck.ts"],
      "@doeixd/metakit/syntax": ["../metakit/src/syntax.ts"],
      "@doeixd/metakit/temporal": ["../metakit/src/temporal.ts"],
      "@doeixd/metakit/tooling": ["../metakit/src/tooling.ts"],
      "foldkit-bundle": ["./src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "tsdown.config.ts"],
  "references": [
    {
      "path": "../metakit/tsconfig.build.json"
    }
  ]
}
