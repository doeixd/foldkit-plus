{
  "name": "foldkit-react-codegen",
  "version": "0.2.0",
  "description": "Compile Foldkit view functions to React TSX, with a diagnostic for every construct that cannot be translated faithfully.",
  "keywords": [
    "foldkit",
    "react",
    "codegen",
    "tsx"
  ],
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "author": "Patrick Glenn <doeixd@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doeixd/foldkit-plus.git",
    "directory": "packages/react-codegen"
  },
  "homepage": "https://foldkit-plus.pages.dev/react/guides/react-codegen",
  "bugs": {
    "url": "https://github.com/doeixd/foldkit-plus/issues"
  },
  "sideEffects": false,
  "bin": {
    "foldkit-react-codegen": "./dist/cli.mjs"
  },
  "exports": {
    ".": {
      "foldkit-plus:source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -b"
  },
  "peerDependencies": {
    "typescript": ">=5.7.2 <7"
  },
  "devDependencies": {
    "@effect/platform-browser": "^4.0.4",
    "@types/node": "22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "effect": "^4.0.4",
    "foldkit": "0.168.0",
    "jsdom": "30.1.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsdown": "0.23.1",
    "typescript": "6.0.3"
  }
}
