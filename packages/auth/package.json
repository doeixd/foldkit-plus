{
  "name": "foldkit-auth",
  "version": "0.1.5",
  "description": "Yielded Auth in Foldkit Plus: a verified session as the principal a Remote server answers as.",
  "keywords": [
    "foldkit",
    "authentication",
    "typescript"
  ],
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "author": "Patrick Glenn <doeixd@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doeixd/foldkit-plus.git",
    "directory": "packages/auth"
  },
  "homepage": "https://foldkit-plus.pages.dev/auth",
  "bugs": {
    "url": "https://github.com/doeixd/foldkit-plus/issues"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "foldkit-plus:source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./server": {
      "foldkit-plus:source": "./src/server.ts",
      "types": "./dist/server.d.mts",
      "import": "./dist/server.mjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -b"
  },
  "peerDependencies": {
    "@yielded/auth": "0.1.0-beta.43",
    "effect": "^4.0.4",
    "foldkit-remote": "workspace:^"
  },
  "devDependencies": {
    "@effect/platform-node": "^4.0.5",
    "@yielded/auth": "0.1.0-beta.43",
    "@yielded/auth-persistence": "0.1.0-beta.43",
    "effect": "^4.0.5",
    "foldkit": "0.169.0",
    "foldkit-entity": "workspace:*",
    "foldkit-remote": "workspace:*",
    "foldkit-remote-server": "workspace:*",
    "foldkit-ssr": "workspace:*",
    "foldkit-sync": "workspace:*",
    "tsdown": "^0.23.1",
    "typescript": "7.0.2"
  }
}
