{
  "name": "foldkit-richtext-markdown",
  "version": "0.3.4",
  "description": "Print a foldkit-richtext document as CommonMark, with a diagnostic for what the mapping cannot express.",
  "keywords": [
    "foldkit",
    "effect",
    "rich-text",
    "markdown",
    "commonmark",
    "typescript"
  ],
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "author": "Patrick Glenn <doeixd@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doeixd/foldkit-plus.git",
    "directory": "packages/richtext-markdown"
  },
  "homepage": "https://foldkit-plus.pages.dev/richtext/guides/richtext-markdown",
  "bugs": {
    "url": "https://github.com/doeixd/foldkit-plus/issues"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "foldkit-plus:source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "foldkit-richtext": "workspace:*",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-gfm": "^3.1.0",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-util-decode-string": "^2.0.1"
  },
  "peerDependencies": {
    "effect": "^4.0.0"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4",
    "effect": "^4.0.5",
    "tsdown": "^0.23.1",
    "typescript": "7.0.2"
  }
}
