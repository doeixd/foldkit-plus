{
  "name": "foldkit-mixins-ui",
  "version": "0.20.1",
  "description": "Published slot contracts and mixin adapters for @foldkit/ui, built on foldkit-mixins.",
  "keywords": [
    "foldkit",
    "effect",
    "slots",
    "styling",
    "ui-components",
    "headless-ui"
  ],
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "author": "Patrick Glenn <doeixd@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doeixd/foldkit-plus.git",
    "directory": "packages/mixins-ui"
  },
  "homepage": "https://foldkit-plus.pages.dev/mixins/guides/mixins-ui",
  "bugs": {
    "url": "https://github.com/doeixd/foldkit-plus/issues"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "foldkit-plus:source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "specimen": "tsx specimen/specimen.ts",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "uqr": "^0.1.3"
  },
  "peerDependencies": {
    "@foldkit/ui": "^0.169.0",
    "effect": "^4.0.0",
    "foldkit": "^0.169.0",
    "foldkit-media": "workspace:^",
    "foldkit-mixins": "workspace:^",
    "foldkit-primitives": "workspace:^"
  },
  "devDependencies": {
    "@effect/platform-browser": "^4.0.5",
    "@foldkit/ui": "0.169.0",
    "effect": "^4.0.5",
    "foldkit": "0.169.0",
    "foldkit-media": "workspace:*",
    "foldkit-mixins": "workspace:*",
    "foldkit-primitives": "workspace:*",
    "jsqr": "^1.4.0",
    "tsdown": "^0.23.1",
    "typescript": "7.0.2"
  }
}
