    "foldkit",
    "effect",
    "submodel",
    "surface"
  ],
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "author": "Patrick Glenn <doeixd@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doeixd/foldkit-plus.git",
    "directory": "packages/bundle-surface"
  },
  "homepage": "https://foldkit-plus.pages.dev/bundle/guides/bundle-surface",
  "bugs": {
