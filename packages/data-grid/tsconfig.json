{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": ".tsbuild",
    "emitDeclarationOnly": true,
    "composite": true,
    "noEmit": false,
    "paths": {
      "foldkit-bundle": ["../bundle/src/index.ts"],
      "foldkit-data-grid": ["./src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "bench/**/*.ts", "tsdown.config.ts"],
  "references": [
    {
      "path": "../bundle/tsconfig.build.json"
    }
  ]
}
