{
  "name": "foldkit-data-grid",
  "version": "0.0.0",
  "private": true,
  "description": "A Foldkit-native data grid: the grid owns interaction state and geometry, the application owns the records.",
  "keywords": [
    "foldkit",
    "data-grid",
    "table",
    "spreadsheet",
    "typescript"
  ],
  "type": "module",
  "license": "MIT",
  "author": "Patrick Glenn <doeixd@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doeixd/foldkit-plus.git",
    "directory": "packages/data-grid"
  },
  "homepage": "https://github.com/doeixd/foldkit-plus/tree/main/packages/data-grid#readme",
  "bugs": {
    "url": "https://github.com/doeixd/foldkit-plus/issues"
  },
  "sideEffects": false,
  "exports": {
    "./crud": {
      "foldkit-plus:source": "./src/crud.ts",
      "types": "./dist/crud.d.mts",
      "import": "./dist/crud.mjs"
    },
    ".": {
      "foldkit-plus:source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "foldkit-bundle": "workspace:*"
  },
  "peerDependencies": {
    "effect": "^4.0.0",
    "foldkit": "^0.165.0",
    "foldkit-crud": "workspace:*",
    "foldkit-remote": "workspace:*"
  },
  "peerDependenciesMeta": {
    "foldkit-crud": {
      "optional": true
    },
    "foldkit-remote": {
      "optional": true
    }
  },
  "devDependencies": {
    "effect": "4.0.0",
    "foldkit": "0.165.0",
    "foldkit-crud": "workspace:*",
    "foldkit-entity": "workspace:*",
    "foldkit-remote": "workspace:*",
    "tsdown": "^0.23.0",
    "typescript": "5.9.3"
  }
}
