    "foldkit",
    "effect",
    "rich-text",
    "syntax-highlighting",
    "shiki",
    "typescript"
  ],
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "author": "Patrick Glenn <doeixd@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doeixd/foldkit-plus.git",
    "directory": "packages/richtext-code-shiki"
  },
  "homepage": "https://github.com/doeixd/foldkit-plus/tree/main/packages/richtext-code-shiki#readme",
  "bugs": {
    "url": "https://github.com/doeixd/foldkit-plus/issues"
  },
  "sideEffects": false,
  "exports": {
