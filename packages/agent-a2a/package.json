  "description": "A2A adapter for foldkit-agent. Serves a Foldkit agent contract as an A2A agent.",
  "keywords": [
    "foldkit",
    "effect",
    "agents",
    "a2a"
  ],
  "type": "module",
  "license": "MIT",
  "author": "Patrick Glenn <doeixd@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doeixd/foldkit-plus.git",
    "directory": "packages/agent-a2a"
  },
  "homepage": "https://foldkit-plus.pages.dev/agent/guides/agent-a2a",
  "bugs": {
    "url": "https://github.com/doeixd/foldkit-plus/issues"
  },
