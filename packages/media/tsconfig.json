{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": ".tsbuild",
    "emitDeclarationOnly": true,
    "composite": true,
    "noEmit": false,
    "paths": {
      "foldkit-media": ["./src/index.ts"],
      "foldkit-media/client": ["./client.d.ts"],
      "foldkit-media/cloudflare": ["./src/cloudflare/index.ts"],
      "foldkit-media/icons": ["./src/icons/index.ts"],
      "foldkit-media/server": ["./src/server/index.ts"],
      "foldkit-media/sharp": ["./src/sharp/index.ts"],
      "foldkit-media/unpic": ["./src/unpic/index.ts"],
      "foldkit-media/vite": ["./src/vite/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "tsdown.config.ts"]
}
