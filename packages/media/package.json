{
  "name": "foldkit-media",
  "version": "0.4.0",
  "description": "Responsive images for Foldkit Plus: an image is a URL to write, through providers that share one width ladder.",
  "keywords": [
    "foldkit",
    "images",
    "responsive",
    "srcset",
    "effect"
  ],
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "author": "Patrick Glenn <doeixd@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doeixd/foldkit-plus.git",
    "directory": "packages/media"
  },
  "bugs": {
    "url": "https://github.com/doeixd/foldkit-plus/issues"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "foldkit-plus:source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "foldkit-plus:source": "./src/browser/index.ts",
      "types": "./dist/browser/index.d.ts",
      "import": "./dist/browser/index.js"
    },
    "./icons": {
      "foldkit-plus:source": "./src/icons/index.ts",
      "types": "./dist/icons/index.d.ts",
      "import": "./dist/icons/index.js"
    },
    "./server": {
      "foldkit-plus:source": "./src/server/index.ts",
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./cloudflare": {
      "foldkit-plus:source": "./src/cloudflare/index.ts",
      "types": "./dist/cloudflare/index.d.ts",
      "import": "./dist/cloudflare/index.js"
    },
    "./sharp": {
      "foldkit-plus:source": "./src/sharp/index.ts",
      "types": "./dist/sharp/index.d.ts",
      "import": "./dist/sharp/index.js"
    },
    "./unpic": {
      "foldkit-plus:source": "./src/unpic/index.ts",
      "types": "./dist/unpic/index.d.ts",
      "import": "./dist/unpic/index.js"
    },
    "./vite": {
      "foldkit-plus:source": "./src/vite/index.ts",
      "types": "./dist/vite/index.d.ts",
      "import": "./dist/vite/index.js"
    },
    "./client": {
      "foldkit-plus:source": "./client.d.ts",
      "types": "./client.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "client.d.ts"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "foldkit-surface": "workspace:*",
    "thumbhash": "^0.1.1"
  },
  "peerDependencies": {
    "effect": "^4.1.0",
    "sharp": ">=0.34.0",
    "unpic": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261022.1",
    "@effect/platform-node": "^4.1.0",
    "effect": "^4.1.0",
    "miniflare": "4.20260730.0",
    "sharp": "^0.35.5",
    "tsdown": "^0.23.1",
    "typescript": "7.0.2",
    "unpic": "^4.2.2",
    "vite": "8.3.5"
  },
  "peerDependenciesMeta": {
    "sharp": {
      "optional": true
    },
    "unpic": {
      "optional": true
    }
  }
}
