{
  "name": "foldkit-react",
  "version": "0.4.1",
  "description": "Run React components inside a Foldkit view and Foldkit programs inside React, with Messages and Ports as the only boundary.",
  "keywords": [
    "foldkit",
    "react",
    "effect",
    "elm-architecture"
  ],
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "author": "Patrick Glenn <doeixd@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doeixd/foldkit-plus.git",
    "directory": "packages/react"
  },
  "homepage": "https://foldkit-plus.pages.dev/react",
  "bugs": {
    "url": "https://github.com/doeixd/foldkit-plus/issues"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "foldkit-plus:source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -b"
  },
  "peerDependencies": {
    "effect": "^4.0.0",
    "foldkit": "^0.169.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@effect/platform-browser": "^4.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "effect": "^4.0.5",
    "foldkit": "0.169.0",
    "jsdom": "30.1.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsdown": "0.23.1",
    "typescript": "7.0.2"
  }
}
