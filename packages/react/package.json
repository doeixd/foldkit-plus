{
  "name": "foldkit-react",
  "version": "0.0.0",
  "description": "Run React components inside a Foldkit view and Foldkit programs inside React, with Messages and Ports as the only boundary.",
  "keywords": [
    "foldkit",
    "react",
    "effect",
    "elm-architecture"
  ],
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "author": "Patrick Glenn <doeixd@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doeixd/foldkit-plus.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/doeixd/foldkit-plus/tree/main/packages/react#readme",
  "bugs": {
    "url": "https://github.com/doeixd/foldkit-plus/issues"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -b"
  },
  "peerDependencies": {
    "effect": "^4.0.0-rc.112",
    "foldkit": "^0.158.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "effect": "4.0.0-rc.112",
    "foldkit": "0.158.2",
    "jsdom": "26.1.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tsdown": "0.23.0",
    "typescript": "5.7.2"
  }
}
