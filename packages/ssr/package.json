{
  "name": "foldkit-ssr",
  "version": "0.1.0",
  "description": "Server rendering for Foldkit Plus: render once on the server, hand the Model over, and hydrate without rerunning init.",
  "keywords": [
    "foldkit",
    "ssr",
    "hydration",
    "typescript"
  ],
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "author": "Patrick Glenn <doeixd@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doeixd/foldkit-plus.git",
    "directory": "packages/ssr"
  },
  "homepage": "https://github.com/doeixd/foldkit-plus/tree/main/packages/ssr#readme",
  "bugs": {
    "url": "https://github.com/doeixd/foldkit-plus/issues"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "foldkit-plus:source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./client": {
      "foldkit-plus:source": "./src/client.ts",
      "types": "./dist/client.d.mts",
      "import": "./dist/client.mjs"
    },
    "./vite": {
      "foldkit-plus:source": "./src/vite.ts",
      "types": "./dist/vite.d.mts",
      "import": "./dist/vite.mjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -b"
  },
  "peerDependencies": {
    "effect": "^4.0.0-rc.116",
    "foldkit": "^0.163.0"
  },
  "dependencies": {
    "foldkit-surface": "workspace:*"
  },
  "devDependencies": {
    "@effect/platform-browser": "4.0.0-rc.116",
    "@types/jsdom": "21.1.7",
    "effect": "4.0.0-rc.116",
    "esbuild": "0.28.2",
    "foldkit": "0.163.0",
    "foldkit-bundle": "workspace:*",
    "foldkit-entity": "workspace:*",
    "foldkit-mirror": "workspace:*",
    "foldkit-remote": "workspace:*",
    "jsdom": "26.1.0",
    "playwright-core": "1.63.0",
    "tsdown": "^0.23.0",
    "typescript": "5.9.3",
    "vite": "5.4.21"
  }
}
