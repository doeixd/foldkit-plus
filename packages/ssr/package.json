{
  "name": "foldkit-ssr",
  "version": "0.9.0",
  "description": "Server rendering for Foldkit Plus: render once on the server, hand the Model over, and hydrate without rerunning init.",
  "keywords": [
    "foldkit",
    "ssr",
    "hydration",
    "typescript"
  ],
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "author": "Patrick Glenn <doeixd@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doeixd/foldkit-plus.git",
    "directory": "packages/ssr"
  },
  "homepage": "https://foldkit-plus.pages.dev/ssr",
  "bugs": {
    "url": "https://github.com/doeixd/foldkit-plus/issues"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "foldkit-plus:source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "foldkit-plus:source": "./src/client.ts",
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./vite": {
      "foldkit-plus:source": "./src/vite.ts",
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -b"
  },
  "peerDependencies": {
    "effect": "^4.1.0",
    "foldkit": "^0.170.0"
  },
  "dependencies": {
    "foldkit-surface": "workspace:*"
  },
  "devDependencies": {
    "@effect/platform-browser": "^4.1.1",
    "@types/jsdom": "30.0.0",
    "effect": "^4.1.1",
    "esbuild": "0.28.2",
    "foldkit": "0.170.0",
    "foldkit-bundle": "workspace:*",
    "foldkit-entity": "workspace:*",
    "foldkit-mirror": "workspace:*",
    "foldkit-remote": "workspace:*",
    "jsdom": "30.1.3",
    "playwright-core": "1.64.1",
    "tsdown": "^0.23.1",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
