{
  "name": "foldkit-mixins",
  "version": "0.21.0",
  "description": "Typed slot contracts and inside-out Style/Behavior attachments for Foldkit.",
  "keywords": [
    "foldkit",
    "effect",
    "slots",
    "styling",
    "behavior",
    "view-composition"
  ],
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "author": "Patrick Glenn <doeixd@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doeixd/foldkit-plus.git",
    "directory": "packages/mixins"
  },
  "homepage": "https://foldkit-plus.pages.dev/mixins",
  "bugs": {
    "url": "https://github.com/doeixd/foldkit-plus/issues"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "foldkit-plus:source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./layers": {
      "foldkit-plus:source": "./src/layers.ts",
      "types": "./dist/layers.d.ts",
      "import": "./dist/layers.js"
    },
    "./theme": {
      "foldkit-plus:source": "./src/theme.ts",
      "types": "./dist/theme.d.ts",
      "import": "./dist/theme.js"
    },
    "./layout": {
      "foldkit-plus:source": "./src/layout.ts",
      "types": "./dist/layout.d.ts",
      "import": "./dist/layout.js"
    },
    "./defaults": {
      "foldkit-plus:source": "./src/defaults.ts",
      "types": "./dist/defaults.d.ts",
      "import": "./dist/defaults.js"
    },
    "./prose": {
      "foldkit-plus:source": "./src/prose.ts",
      "types": "./dist/prose.d.ts",
      "import": "./dist/prose.js"
    },
    "./app": {
      "foldkit-plus:source": "./src/app.ts",
      "types": "./dist/app.d.ts",
      "import": "./dist/app.js"
    },
    "./utilities": {
      "foldkit-plus:source": "./src/utilities.ts",
      "types": "./dist/utilities.d.ts",
      "import": "./dist/utilities.js"
    },
    "./testing": {
      "foldkit-plus:source": "./src/testing.ts",
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    },
    "./foundations": {
      "foldkit-plus:source": "./src/foundations.ts",
      "types": "./dist/foundations.d.ts",
      "import": "./dist/foundations.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -b"
  },
  "peerDependencies": {
    "effect": "^4.1.0",
    "foldkit": "^0.170.0"
  },
  "devDependencies": {
    "@effect/platform-browser": "^4.1.1",
    "effect": "^4.1.1",
    "foldkit": "0.170.0",
    "tsdown": "^0.23.1",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "dependencies": {
    "csstype": "^3.2.3",
    "foldkit-surface": "workspace:*"
  }
}
