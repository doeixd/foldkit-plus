{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": ".tsbuild",
    "emitDeclarationOnly": true,
    "composite": true,
    "noEmit": false,
    "paths": {
      "foldkit-metadata": ["../metadata/src/index.ts"],
      "foldkit-mixins": ["./src/index.ts"],
      "foldkit-mixins/app": ["./src/app.ts"],
      "foldkit-mixins/defaults": ["./src/defaults.ts"],
      "foldkit-mixins/foundations": ["./src/foundations.ts"],
      "foldkit-mixins/layers": ["./src/layers.ts"],
      "foldkit-mixins/layout": ["./src/layout.ts"],
      "foldkit-mixins/prose": ["./src/prose.ts"],
      "foldkit-mixins/testing": ["./src/testing.ts"],
      "foldkit-mixins/theme": ["./src/theme.ts"],
      "foldkit-mixins/utilities": ["./src/utilities.ts"],
      "foldkit-surface": ["../surface/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "tsdown.config.ts"],
  "references": [
    {
      "path": "../metadata/tsconfig.build.json"
    },
    {
      "path": "../surface/tsconfig.build.json"
    }
  ]
}
