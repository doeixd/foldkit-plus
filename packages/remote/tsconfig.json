{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": ".tsbuild",
    "emitDeclarationOnly": true,
    "composite": true,
    "noEmit": false,
    "paths": {
      "foldkit-bundle": ["../bundle/src/index.ts"],
      "foldkit-entity": ["../entity/src/index.ts"],
      "foldkit-entity/conformance": ["../entity/src/conformance/index.ts"],
      "foldkit-metadata": ["../metadata/src/index.ts"],
      "foldkit-remote": ["./src/index.ts"],
      "foldkit-remote/aggregate": ["./src/aggregate.ts"],
      "foldkit-remote/filter": ["./src/filter.ts"],
      "foldkit-remote/live": ["./src/live.ts"],
      "foldkit-remote/outbox": ["./src/outbox.ts"],
      "foldkit-remote/overlay": ["./src/overlay.ts"],
      "foldkit-remote/persistence": ["./src/persistence.ts"],
      "foldkit-remote/port": ["./src/port.ts"],
      "foldkit-remote/testing": ["./src/testing.ts"],
      "foldkit-remote/why": ["./src/why.ts"],
      "foldkit-surface": ["../surface/src/index.ts"],
      "foldkit-surface/writes": ["../surface/src/writes.ts"],
      "metakit": ["../metakit/src/index.ts"],
      "metakit/aggregates": ["../metakit/src/aggregates.ts"],
      "metakit/aggregates/sql": ["../metakit/src/aggregatesSql.ts"],
      "metakit/conformance": ["../metakit/src/conformance.ts"],
      "metakit/domain": ["../metakit/src/domain.ts"],
      "metakit/drizzle": ["../metakit/src/drizzle.ts"],
      "metakit/graph": ["../metakit/src/graph.ts"],
      "metakit/graph/match": ["../metakit/src/graph/match.ts"],
      "metakit/graph/prune": ["../metakit/src/graph/prune.ts"],
      "metakit/graph/readiness": ["../metakit/src/graph/readiness.ts"],
      "metakit/inspect": ["../metakit/src/inspect.ts"],
      "metakit/machine": ["../metakit/src/machine.ts"],
      "metakit/policy": ["../metakit/src/policy.ts"],
      "metakit/prove": ["../metakit/src/prove.ts"],
      "metakit/sql": ["../metakit/src/sql.ts"],
      "metakit/store": ["../metakit/src/store.ts"],
      "metakit/temporal": ["../metakit/src/temporal.ts"]
    }
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "tsdown.config.ts"],
  "references": [
    {
      "path": "../metakit/tsconfig.build.json"
    },
    {
      "path": "../bundle/tsconfig.build.json"
    },
    {
      "path": "../metadata/tsconfig.build.json"
    },
    {
      "path": "../entity/tsconfig.build.json"
    },
    {
      "path": "../surface/tsconfig.build.json"
    }
  ]
}
