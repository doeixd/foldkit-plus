{
  "name": "foldkit-remote",
  "version": "0.22.0",
  "description": "Normalized application-facing server state for Foldkit: entities, selections, and the pure remote core.",
  "keywords": [
    "foldkit",
    "effect",
    "normalized-cache",
    "server-state",
    "data-fetching",
    "schema"
  ],
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "author": "Patrick Glenn <doeixd@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doeixd/foldkit-plus.git",
    "directory": "packages/remote"
  },
  "homepage": "https://foldkit-plus.pages.dev/remote",
  "bugs": {
    "url": "https://github.com/doeixd/foldkit-plus/issues"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "foldkit-plus:source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./port": {
      "foldkit-plus:source": "./src/port.ts",
      "types": "./dist/port.d.ts",
      "import": "./dist/port.js"
    },
    "./testing": {
      "foldkit-plus:source": "./src/testing.ts",
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    },
    "./why": {
      "foldkit-plus:source": "./src/why.ts",
      "types": "./dist/why.d.ts",
      "import": "./dist/why.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "foldkit-entity": "workspace:*",
    "foldkit-metadata": "workspace:*",
    "foldkit-surface": "workspace:*"
  },
  "peerDependencies": {
    "effect": "^4.1.0",
    "foldkit": "^0.170.0"
  },
  "devDependencies": {
    "@effect/platform-browser": "^4.1.1",
    "effect": "^4.1.1",
    "foldkit": "0.170.0",
    "foldkit-bundle": "workspace:*",
    "tsdown": "^0.23.1",
    "typescript": "7.0.2"
  }
}
