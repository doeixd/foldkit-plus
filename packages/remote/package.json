{
  "name": "foldkit-remote",
  "version": "0.8.0",
  "description": "Normalized application-facing server state for Foldkit: entities, selections, and the pure remote core.",
  "keywords": [
    "foldkit",
    "effect",
    "normalized-cache",
    "server-state",
    "data-fetching",
    "schema"
  ],
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "author": "Patrick Glenn <doeixd@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doeixd/foldkit-plus.git",
    "directory": "packages/remote"
  },
  "homepage": "https://github.com/doeixd/foldkit-plus/tree/main/packages/remote#readme",
  "bugs": {
    "url": "https://github.com/doeixd/foldkit-plus/issues"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "foldkit-entity": "workspace:*",
    "foldkit-surface": "workspace:*"
  },
  "peerDependencies": {
    "effect": "^4.0.0-rc.116",
    "foldkit": "^0.163.0"
  },
  "devDependencies": {
    "@effect/platform-browser": "4.0.0-rc.116",
    "effect": "4.0.0-rc.116",
    "foldkit": "0.163.0",
    "foldkit-bundle": "workspace:*",
    "tsdown": "^0.23.0",
    "typescript": "5.9.3"
  }
}
