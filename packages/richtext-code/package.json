{
  "name": "foldkit-richtext-code",
  "version": "0.2.4",
  "description": "Code tokenizers for foldkit-richtext's CodeBlock, producing syntax decorations.",
  "keywords": [
    "foldkit",
    "effect",
    "rich-text",
    "syntax-highlighting",
    "json",
    "typescript"
  ],
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "author": "Patrick Glenn <doeixd@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doeixd/foldkit-plus.git",
    "directory": "packages/richtext-code"
  },
  "homepage": "https://foldkit-plus.pages.dev/richtext/guides/richtext-code",
  "bugs": {
    "url": "https://github.com/doeixd/foldkit-plus/issues"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "foldkit-plus:source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "foldkit-richtext": "workspace:*"
  },
  "peerDependencies": {
    "effect": "^4.0.0"
  },
  "devDependencies": {
    "effect": "^4.0.5",
    "tsdown": "^0.23.1",
    "typescript": "7.0.2"
  }
}
