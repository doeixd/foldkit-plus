{
  "name": "foldkit-sync",
  "version": "0.17.0",
  "description": "A local-first replica of a shared Foldkit projection: offline outbox, optimistic updates, and reconciliation.",
  "keywords": [
    "foldkit",
    "effect",
    "local-first",
    "offline",
    "replication",
    "indexeddb"
  ],
  "type": "module",
  "license": "MIT",
  "author": "Patrick Glenn <doeixd@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doeixd/foldkit-plus.git",
    "directory": "packages/sync"
  },
  "homepage": "https://foldkit-plus.pages.dev/sync",
  "bugs": {
    "url": "https://github.com/doeixd/foldkit-plus/issues"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "foldkit-plus:source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./journal": {
      "foldkit-plus:source": "./src/journal.ts",
      "types": "./dist/journal.d.ts",
      "import": "./dist/journal.js"
    },
    "./entity": {
      "foldkit-plus:source": "./src/entity.ts",
      "types": "./dist/entity.d.ts",
      "import": "./dist/entity.js"
    },
    "./do": {
      "foldkit-plus:source": "./src/do.ts",
      "types": "./dist/do.d.ts",
      "import": "./dist/do.js"
    },
    "./remote": {
      "foldkit-plus:source": "./src/remote.ts",
      "types": "./dist/remote.d.ts",
      "import": "./dist/remote.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node ../../scripts/declarations.mjs . && tsdown && node ../../scripts/declared-any.mjs .",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "foldkit-surface": "workspace:*"
  },
  "peerDependencies": {
    "effect": "^4.1.0",
    "foldkit": "^0.170.0",
    "foldkit-durable": "workspace:*",
    "foldkit-remote": "workspace:*"
  },
  "peerDependenciesMeta": {
    "foldkit-durable": {
      "optional": true
    },
    "foldkit-remote": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261022.1",
    "@effect/platform-browser": "4.1.4",
    "@effect/sql-d1": "^4.1.4",
    "@types/ws": "^8.18.2",
    "effect": "4.1.4",
    "esbuild": "0.28.2",
    "fake-indexeddb": "6.2.6",
    "foldkit": "0.170.0",
    "foldkit-agent": "workspace:*",
    "foldkit-durable": "workspace:*",
    "foldkit-entity": "workspace:*",
    "foldkit-remote": "workspace:*",
    "jsdom": "30.1.3",
    "miniflare": "4.20260730.0",
    "tsdown": "^0.23.1",
    "typescript": "7.0.2",
    "ws": "^8.22.0"
  }
}
