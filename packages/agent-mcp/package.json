{
  "name": "foldkit-agent-mcp",
  "version": "0.4.0",
  "description": "External MCP adapter for foldkit-agent. Serves a Foldkit agent contract over the Model Context Protocol.",
  "keywords": [
    "foldkit",
    "effect",
    "agents",
    "mcp",
    "model-context-protocol"
  ],
  "type": "module",
  "license": "MIT",
  "author": "Patrick Glenn <doeixd@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doeixd/foldkit-plus.git",
    "directory": "packages/agent-mcp"
  },
  "homepage": "https://github.com/doeixd/foldkit-plus/tree/main/packages/agent-mcp#readme",
  "bugs": {
    "url": "https://github.com/doeixd/foldkit-plus/issues"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -b"
  },
  "peerDependencies": {
    "foldkit-agent": "workspace:^",
    "effect": "^4.0.0-rc.116",
    "foldkit": "^0.163.0"
  },
  "devDependencies": {
    "@effect/platform-browser": "4.0.0-rc.116",
    "effect": "4.0.0-rc.116",
    "foldkit": "0.163.0",
    "foldkit-agent": "workspace:*",
    "foldkit-surface": "workspace:*",
    "tsdown": "^0.23.0",
    "typescript": "5.9.3"
  }
}
