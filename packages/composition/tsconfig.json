{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": ".tsbuild",
    "emitDeclarationOnly": true,
    "composite": true,
    "noEmit": false,
    "paths": {
      "foldkit-bundle": ["../bundle/src/index.ts"],
      "foldkit-composition": ["./src/index.ts"],
      "foldkit-composition/appearance": ["./src/appearance/index.ts"],
      "foldkit-composition/foldkit": ["./src/foldkit/index.ts"],
      "foldkit-composition/remote": ["./src/remote/index.ts"],
      "foldkit-composition/richtext": ["./src/richtext/index.ts"],
      "foldkit-composition/surface": ["./src/surface/index.ts"],
      "foldkit-entity": ["../entity/src/index.ts"],
      "foldkit-entity/conformance": ["../entity/src/conformance/index.ts"],
      "foldkit-metadata": ["../metadata/src/index.ts"],
      "foldkit-mixins": ["../mixins/src/index.ts"],
      "foldkit-mixins/defaults": ["../mixins/src/defaults.ts"],
      "foldkit-mixins/layers": ["../mixins/src/layers.ts"],
      "foldkit-mixins/layout": ["../mixins/src/layout.ts"],
      "foldkit-mixins/prose": ["../mixins/src/prose.ts"],
      "foldkit-mixins/testing": ["../mixins/src/testing.ts"],
      "foldkit-mixins/theme": ["../mixins/src/theme.ts"],
      "foldkit-react": ["../react/src/index.ts"],
      "foldkit-remote": ["../remote/src/index.ts"],
      "foldkit-richtext": ["../richtext/src/index.ts"],
      "foldkit-richtext-dom": ["../richtext-dom/src/index.ts"],
      "foldkit-richtext-dom/editor": ["../richtext-dom/src/editor.ts"],
      "foldkit-richtext-dom/editor-bundle": ["../richtext-dom/src/editor-bundle.ts"],
      "foldkit-richtext-dom/events": ["../richtext-dom/src/events.ts"],
      "foldkit-richtext-dom/host": ["../richtext-dom/src/host.ts"],
      "foldkit-richtext-dom/html": ["../richtext-dom/src/html.ts"],
      "foldkit-richtext-dom/input": ["../richtext-dom/src/input.ts"],
      "foldkit-richtext-dom/toolbar": ["../richtext-dom/src/toolbar.ts"],
      "foldkit-richtext-dom/view": ["../richtext-dom/src/view.ts"],
      "foldkit-ssr": ["../ssr/src/index.ts"],
      "foldkit-surface": ["../surface/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "bench/**/*.ts", "tsdown.config.ts"],
  "references": [
    {
      "path": "../metadata/tsconfig.build.json"
    },
    {
      "path": "../entity/tsconfig.build.json"
    },
    {
      "path": "../richtext/tsconfig.build.json"
    },
    {
      "path": "../richtext-dom/tsconfig.build.json"
    },
    {
      "path": "../ssr/tsconfig.build.json"
    },
    {
      "path": "../surface/tsconfig.build.json"
    },
    {
      "path": "../mixins/tsconfig.build.json"
    },
    {
      "path": "../remote/tsconfig.build.json"
    },
    {
      "path": "../bundle/tsconfig.build.json"
    },
    {
      "path": "../react/tsconfig.build.json"
    }
  ]
}
