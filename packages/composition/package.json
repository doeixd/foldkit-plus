{
  "name": "foldkit-composition",
  "version": "0.0.0",
  "private": true,
  "description": "Composition for Foldkit Plus: a page as a stored Document of Blocks in Regions, checked against a Catalog, with no view and no runtime.",
  "keywords": [
    "foldkit",
    "effect",
    "composition",
    "page-builder",
    "cms",
    "typescript"
  ],
  "type": "module",
  "license": "MIT",
  "author": "Patrick Glenn <doeixd@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doeixd/foldkit-plus.git",
    "directory": "packages/composition"
  },
  "homepage": "https://github.com/doeixd/foldkit-plus/tree/main/packages/composition#readme",
  "bugs": {
    "url": "https://github.com/doeixd/foldkit-plus/issues"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./foldkit": {
      "types": "./dist/foldkit.d.mts",
      "import": "./dist/foldkit.mjs"
    },
    "./richtext": {
      "types": "./dist/richtext.d.mts",
      "import": "./dist/richtext.mjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -b"
  },
  "peerDependencies": {
    "effect": "^4.0.0-rc.116",
    "foldkit": "^0.163.0",
    "foldkit-richtext": "workspace:^"
  },
  "dependencies": {
    "foldkit-metadata": "workspace:*"
  },
  "devDependencies": {
    "effect": "4.0.0-rc.116",
    "foldkit": "0.163.0",
    "foldkit-entity": "workspace:*",
    "foldkit-richtext": "workspace:*",
    "foldkit-richtext-dom": "workspace:*",
    "foldkit-ssr": "workspace:*",
    "foldkit-surface": "workspace:*",
    "tsdown": "^0.23.0",
    "typescript": "5.9.3"
  },
  "peerDependenciesMeta": {
    "foldkit": {
      "optional": true
    },
    "foldkit-richtext": {
      "optional": true
    }
  }
}
