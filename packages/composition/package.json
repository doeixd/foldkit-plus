{
  "name": "foldkit-composition",
  "version": "0.4.0",
  "description": "Composition for Foldkit Plus: a page as a stored Document of Blocks in Regions, checked against a Catalog, with no view and no runtime.",
  "keywords": [
    "foldkit",
    "effect",
    "composition",
    "page-builder",
    "cms",
    "typescript"
  ],
  "type": "module",
  "license": "MIT",
  "author": "Patrick Glenn <doeixd@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doeixd/foldkit-plus.git",
    "directory": "packages/composition"
  },
  "homepage": "https://foldkit-plus.pages.dev/composition",
  "bugs": {
    "url": "https://github.com/doeixd/foldkit-plus/issues"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "foldkit-plus:source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./foldkit": {
      "foldkit-plus:source": "./src/foldkit/index.ts",
      "types": "./dist/foldkit/index.d.ts",
      "import": "./dist/foldkit/index.js"
    },
    "./richtext": {
      "foldkit-plus:source": "./src/richtext/index.ts",
      "types": "./dist/richtext/index.d.ts",
      "import": "./dist/richtext/index.js"
    },
    "./appearance": {
      "foldkit-plus:source": "./src/appearance/index.ts",
      "types": "./dist/appearance/index.d.ts",
      "import": "./dist/appearance/index.js"
    },
    "./remote": {
      "foldkit-plus:source": "./src/remote/index.ts",
      "types": "./dist/remote/index.d.ts",
      "import": "./dist/remote/index.js"
    },
    "./surface": {
      "foldkit-plus:source": "./src/surface/index.ts",
      "types": "./dist/surface/index.d.ts",
      "import": "./dist/surface/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -b"
  },
  "peerDependencies": {
    "effect": "^4.1.0",
    "foldkit": "^0.170.0",
    "foldkit-mixins": "workspace:^",
    "foldkit-remote": "workspace:^",
    "foldkit-richtext": "workspace:^",
    "foldkit-surface": "workspace:^"
  },
  "dependencies": {
    "foldkit-metadata": "workspace:*"
  },
  "devDependencies": {
    "effect": "^4.1.1",
    "foldkit": "0.170.0",
    "foldkit-bundle": "workspace:*",
    "foldkit-entity": "workspace:*",
    "foldkit-mixins": "workspace:*",
    "foldkit-react": "workspace:*",
    "foldkit-remote": "workspace:*",
    "foldkit-richtext": "workspace:*",
    "foldkit-richtext-dom": "workspace:*",
    "foldkit-ssr": "workspace:*",
    "foldkit-surface": "workspace:*",
    "@types/react": "^19.3.0",
    "jsdom": "30.1.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsdown": "^0.23.1",
    "typescript": "7.0.2"
  },
  "peerDependenciesMeta": {
    "foldkit": {
      "optional": true
    },
    "foldkit-mixins": {
      "optional": true
    },
    "foldkit-remote": {
      "optional": true
    },
    "foldkit-surface": {
      "optional": true
    },
    "foldkit-richtext": {
      "optional": true
    }
  }
}
