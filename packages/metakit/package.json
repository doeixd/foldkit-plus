{
  "name": "metakit",
  "version": "0.1.0",
  "description": "Inspectable expressions and single-step transitions over Effect Schema: one rule read by evaluation, partial evaluation, SQL, interval/zone checks and Z3.",
  "keywords": [
    "effect",
    "schema",
    "expression",
    "partial-evaluation",
    "sql",
    "z3",
    "typescript"
  ],
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "author": "Patrick Glenn <doeixd@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doeixd/foldkit-plus.git",
    "directory": "packages/metakit"
  },
  "bugs": {
    "url": "https://github.com/doeixd/foldkit-plus/issues"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "foldkit-plus:source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./domain": {
      "foldkit-plus:source": "./src/domain.ts",
      "types": "./dist/domain.d.ts",
      "import": "./dist/domain.js"
    },
    "./aggregates": {
      "foldkit-plus:source": "./src/aggregates.ts",
      "types": "./dist/aggregates.d.ts",
      "import": "./dist/aggregates.js"
    },
    "./aggregates/sql": {
      "foldkit-plus:source": "./src/aggregatesSql.ts",
      "types": "./dist/aggregatesSql.d.ts",
      "import": "./dist/aggregatesSql.js"
    },
    "./drizzle": {
      "foldkit-plus:source": "./src/drizzle.ts",
      "types": "./dist/drizzle.d.ts",
      "import": "./dist/drizzle.js"
    },
    "./machine": {
      "foldkit-plus:source": "./src/machine.ts",
      "types": "./dist/machine.d.ts",
      "import": "./dist/machine.js"
    },
    "./inspect": {
      "foldkit-plus:source": "./src/inspect.ts",
      "types": "./dist/inspect.d.ts",
      "import": "./dist/inspect.js"
    },
    "./graph": {
      "foldkit-plus:source": "./src/graph.ts",
      "types": "./dist/graph.d.ts",
      "import": "./dist/graph.js"
    },
    "./graph/match": {
      "foldkit-plus:source": "./src/graph/match.ts",
      "types": "./dist/graph/match.d.ts",
      "import": "./dist/graph/match.js"
    },
    "./graph/prune": {
      "foldkit-plus:source": "./src/graph/prune.ts",
      "types": "./dist/graph/prune.d.ts",
      "import": "./dist/graph/prune.js"
    },
    "./graph/readiness": {
      "foldkit-plus:source": "./src/graph/readiness.ts",
      "types": "./dist/graph/readiness.d.ts",
      "import": "./dist/graph/readiness.js"
    },
    "./policy": {
      "foldkit-plus:source": "./src/policy.ts",
      "types": "./dist/policy.d.ts",
      "import": "./dist/policy.js"
    },
    "./store": {
      "foldkit-plus:source": "./src/store.ts",
      "types": "./dist/store.d.ts",
      "import": "./dist/store.js"
    },
    "./pairs": {
      "foldkit-plus:source": "./src/pairs.ts",
      "types": "./dist/pairs.d.ts",
      "import": "./dist/pairs.js"
    },
    "./temporal": {
      "foldkit-plus:source": "./src/temporal.ts",
      "types": "./dist/temporal.d.ts",
      "import": "./dist/temporal.js"
    },
    "./sql": {
      "foldkit-plus:source": "./src/sql.ts",
      "types": "./dist/sql.d.ts",
      "import": "./dist/sql.js"
    },
    "./prove": {
      "foldkit-plus:source": "./src/prove.ts",
      "types": "./dist/prove.d.ts",
      "import": "./dist/prove.js"
    },
    "./conformance": {
      "foldkit-plus:source": "./src/conformance.ts",
      "types": "./dist/conformance.d.ts",
      "import": "./dist/conformance.js"
    },
    "./build": {
      "foldkit-plus:source": "./src/build.ts",
      "types": "./dist/build.d.ts",
      "import": "./dist/build.js"
    },
    "./relation": {
      "foldkit-plus:source": "./src/relation.ts",
      "types": "./dist/relation.d.ts",
      "import": "./dist/relation.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node ../../scripts/declarations.mjs . && tsdown && node ../../scripts/declared-any.mjs .",
    "typecheck": "tsc -b"
  },
  "peerDependencies": {
    "drizzle-orm": "1.0.0-rc.5",
    "effect": "^4.1.0",
    "z3-solver": ">=4.15.0"
  },
  "peerDependenciesMeta": {
    "drizzle-orm": {
      "optional": true
    },
    "z3-solver": {
      "optional": true
    }
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.11",
    "drizzle-orm": "1.0.0-rc.5",
    "effect": "4.1.4",
    "tsdown": "^0.23.1",
    "typescript": "7.0.2",
    "z3-solver": "5.4.1"
  }
}
