{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": ".tsbuild",
    "emitDeclarationOnly": true,
    "composite": true,
    "noEmit": false,
    "paths": {
      "metakit": ["./src/index.ts"],
      "metakit/aggregates": ["./src/aggregates.ts"],
      "metakit/aggregates/sql": ["./src/aggregatesSql.ts"],
      "metakit/conformance": ["./src/conformance.ts"],
      "metakit/domain": ["./src/domain.ts"],
      "metakit/drizzle": ["./src/drizzle.ts"],
      "metakit/graph": ["./src/graph.ts"],
      "metakit/inspect": ["./src/inspect.ts"],
      "metakit/machine": ["./src/machine.ts"],
      "metakit/policy": ["./src/policy.ts"],
      "metakit/prove": ["./src/prove.ts"],
      "metakit/sql": ["./src/sql.ts"]
    }
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "tsdown.config.ts"]
}
