{
  "name": "foldkit-builder",
  "version": "0.0.0",
  "private": true,
  "description": "The page builder's state for Foldkit Plus: a Bundle that edits a foldkit-composition Document by Operations, with selection and undo, as one form key's control.",
  "keywords": [
    "foldkit",
    "effect",
    "page-builder",
    "composition",
    "cms",
    "typescript"
  ],
  "type": "module",
  "license": "MIT",
  "author": "Patrick Glenn <doeixd@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doeixd/foldkit-plus.git",
    "directory": "packages/builder"
  },
  "homepage": "https://github.com/doeixd/foldkit-plus/tree/main/packages/builder#readme",
  "bugs": {
    "url": "https://github.com/doeixd/foldkit-plus/issues"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -b"
  },
  "peerDependencies": {
    "effect": "^4.0.0-rc.116",
    "foldkit": "^0.163.0"
  },
  "dependencies": {
    "foldkit-bundle": "workspace:*",
    "foldkit-composition": "workspace:*",
    "foldkit-form": "workspace:*",
    "foldkit-primitives": "workspace:*"
  },
  "devDependencies": {
    "effect": "4.0.0-rc.116",
    "foldkit": "0.163.0",
    "foldkit-entity": "workspace:*",
    "foldkit-mixins": "workspace:*",
    "foldkit-mixins-form": "workspace:*",
    "jsdom": "26.1.0",
    "tsdown": "^0.23.0",
    "typescript": "5.9.3"
  }
}
