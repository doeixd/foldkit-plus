{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": ".tsbuild",
    "emitDeclarationOnly": true,
    "composite": true,
    "noEmit": false,
    "paths": {
      "foldkit-builder": ["./src/index.ts"],
      "foldkit-bundle": ["../bundle/src/index.ts"],
      "foldkit-composition": ["../composition/src/index.ts"],
      "foldkit-composition/appearance": ["../composition/src/appearance/index.ts"],
      "foldkit-composition/foldkit": ["../composition/src/foldkit/index.ts"],
      "foldkit-composition/remote": ["../composition/src/remote/index.ts"],
      "foldkit-composition/richtext": ["../composition/src/richtext/index.ts"],
      "foldkit-composition/surface": ["../composition/src/surface/index.ts"],
      "foldkit-entity": ["../entity/src/index.ts"],
      "foldkit-entity/conformance": ["../entity/src/conformance/index.ts"],
      "foldkit-form": ["../form/src/index.ts"],
      "foldkit-metadata": ["../metadata/src/index.ts"],
      "foldkit-mixins": ["../mixins/src/index.ts"],
      "foldkit-mixins-form": ["../mixins-form/src/index.ts"],
      "foldkit-mixins-form/ui": ["../mixins-form/src/ui.ts"],
      "foldkit-mixins/app": ["../mixins/src/app.ts"],
      "foldkit-mixins/defaults": ["../mixins/src/defaults.ts"],
      "foldkit-mixins/foundations": ["../mixins/src/foundations.ts"],
      "foldkit-mixins/layers": ["../mixins/src/layers.ts"],
      "foldkit-mixins/layout": ["../mixins/src/layout.ts"],
      "foldkit-mixins/prose": ["../mixins/src/prose.ts"],
      "foldkit-mixins/testing": ["../mixins/src/testing.ts"],
      "foldkit-mixins/theme": ["../mixins/src/theme.ts"],
      "foldkit-mixins/utilities": ["../mixins/src/utilities.ts"],
      "foldkit-primitives": ["../primitives/src/index.ts"],
      "foldkit-primitives/device": ["../primitives/src/device/index.ts"],
      "foldkit-primitives/dom": ["../primitives/src/dom/index.ts"],
      "foldkit-primitives/events": ["../primitives/src/events/index.ts"],
      "foldkit-primitives/interaction": ["../primitives/src/interaction/index.ts"],
      "foldkit-primitives/media": ["../primitives/src/media/index.ts"],
      "foldkit-primitives/motion": ["../primitives/src/motion/index.ts"],
      "foldkit-primitives/net": ["../primitives/src/net/index.ts"],
      "foldkit-primitives/observers": ["../primitives/src/observers/index.ts"],
      "foldkit-primitives/state": ["../primitives/src/state/index.ts"],
      "foldkit-primitives/time": ["../primitives/src/time/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "tsdown.config.ts"],
  "references": [
    {
      "path": "../bundle/tsconfig.build.json"
    },
    {
      "path": "../composition/tsconfig.build.json"
    },
    {
      "path": "../entity/tsconfig.build.json"
    },
    {
      "path": "../form/tsconfig.build.json"
    },
    {
      "path": "../metadata/tsconfig.build.json"
    },
    {
      "path": "../mixins/tsconfig.build.json"
    },
    {
      "path": "../mixins-form/tsconfig.build.json"
    },
    {
      "path": "../primitives/tsconfig.build.json"
    }
  ]
}
