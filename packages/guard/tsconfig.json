{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": ".tsbuild",
    "emitDeclarationOnly": true,
    "composite": true,
    "noEmit": false,
    "paths": {
      "foldkit-agent": ["../agent/src/index.ts"],
      "foldkit-entity": ["../entity/src/index.ts"],
      "foldkit-entity/conformance": ["../entity/src/conformance/index.ts"],
      "foldkit-guard": ["./src/index.ts"],
      "foldkit-guard/agent": ["./src/agent.ts"],
      "foldkit-guard/drizzle": ["./src/drizzle.ts"],
      "foldkit-guard/media": ["./src/media.ts"],
      "foldkit-guard/server": ["./src/server.ts"],
      "foldkit-guard/sync": ["./src/sync.ts"],
      "foldkit-media": ["../media/src/index.ts"],
      "foldkit-media/browser": ["../media/src/browser/index.ts"],
      "foldkit-media/client": ["../media/client.d.ts"],
      "foldkit-media/cloudflare": ["../media/src/cloudflare/index.ts"],
      "foldkit-media/icons": ["../media/src/icons/index.ts"],
      "foldkit-media/server": ["../media/src/server/index.ts"],
      "foldkit-media/sharp": ["../media/src/sharp/index.ts"],
      "foldkit-media/unpic": ["../media/src/unpic/index.ts"],
      "foldkit-media/vite": ["../media/src/vite/index.ts"],
      "foldkit-metadata": ["../metadata/src/index.ts"],
      "foldkit-remote": ["../remote/src/index.ts"],
      "foldkit-remote-drizzle": ["../remote-drizzle/src/index.ts"],
      "foldkit-remote-server": ["../remote-server/src/index.ts"],
      "foldkit-remote-server/fetch": ["../remote-server/src/fetch.ts"],
      "foldkit-remote-server/port": ["../remote-server/src/port.ts"],
      "foldkit-remote/filter": ["../remote/src/filter.ts"],
      "foldkit-remote/overlay": ["../remote/src/overlay.ts"],
      "foldkit-remote/port": ["../remote/src/port.ts"],
      "foldkit-remote/testing": ["../remote/src/testing.ts"],
      "foldkit-remote/why": ["../remote/src/why.ts"],
      "foldkit-surface": ["../surface/src/index.ts"],
      "foldkit-sync": ["../sync/src/index.ts"],
      "foldkit-sync/do": ["../sync/src/do.ts"],
      "foldkit-sync/entity": ["../sync/src/entity.ts"],
      "foldkit-sync/journal": ["../sync/src/journal.ts"],
      "foldkit-sync/remote": ["../sync/src/remote.ts"]
    }
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "tsdown.config.ts"],
  "references": [
    {
      "path": "../entity/tsconfig.build.json"
    },
    {
      "path": "../metadata/tsconfig.build.json"
    },
    {
      "path": "../remote/tsconfig.build.json"
    },
    {
      "path": "../remote-server/tsconfig.build.json"
    },
    {
      "path": "../remote-drizzle/tsconfig.build.json"
    },
    {
      "path": "../sync/tsconfig.build.json"
    },
    {
      "path": "../agent/tsconfig.build.json"
    },
    {
      "path": "../surface/tsconfig.build.json"
    },
    {
      "path": "../media/tsconfig.build.json"
    }
  ]
}
