    "foldkit-richtext-markdown": "workspace:*"
  },
  "peerDependencies": {
    "effect": "^4.0.0",
    "foldkit": "^0.165.0"
  },
  "devDependencies": {
    "effect": "4.0.0",
    "foldkit": "0.165.0",
    "jsdom": "26.1.0",
    "tsdown": "^0.23.0",
    "typescript": "5.9.3"
  }
