{
  "name": "foldkit-mixins-richtext",
  "version": "0.2.2",
  "description": "The rich-text editor's chrome, drawn through Mixins slots.",
  "keywords": [
    "foldkit",
    "rich-text",
    "editor",
    "toolbar",
    "mixins",
    "typescript"
  ],
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "author": "Patrick Glenn <doeixd@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doeixd/foldkit-plus.git",
    "directory": "packages/mixins-richtext"
  },
  "homepage": "https://github.com/doeixd/foldkit-plus/tree/main/packages/mixins-richtext#readme",
  "bugs": {
    "url": "https://github.com/doeixd/foldkit-plus/issues"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "foldkit-plus:source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
