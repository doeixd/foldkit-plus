{
  "name": "foldkit-mixins-richtext",
  "version": "0.2.4",
  "description": "The rich-text editor's chrome, drawn through Mixins slots.",
  "keywords": [
    "foldkit",
    "rich-text",
    "editor",
    "toolbar",
    "mixins",
    "typescript"
  ],
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "author": "Patrick Glenn <doeixd@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doeixd/foldkit-plus.git",
    "directory": "packages/mixins-richtext"
  },
  "homepage": "https://foldkit-plus.pages.dev/richtext/guides/mixins-richtext",
  "bugs": {
    "url": "https://github.com/doeixd/foldkit-plus/issues"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "foldkit-plus:source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -b",
    "smoke": "node smoke/build.mjs"
  },
  "dependencies": {
    "foldkit-mixins": "workspace:*",
    "foldkit-primitives": "workspace:*",
    "foldkit-richtext": "workspace:*",
    "foldkit-richtext-dom": "workspace:*",
    "foldkit-richtext-markdown": "workspace:*"
  },
  "peerDependencies": {
    "effect": "^4.0.0",
    "foldkit": "^0.168.0"
  },
  "devDependencies": {
    "effect": "^4.0.4",
    "foldkit": "0.168.0",
    "jsdom": "30.1.2",
    "tsdown": "^0.23.1",
    "typescript": "6.0.3"
  }
}
