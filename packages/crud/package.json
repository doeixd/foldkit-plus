{
  "name": "foldkit-crud",
  "version": "0.4.0",
  "description": "Create, read, update and delete screens for Foldkit Plus, assembled from a form, a Remote operation, and the Entity they share. Each capability is declared, never implied.",
  "keywords": [
    "foldkit",
    "effect",
    "crud",
    "admin",
    "form",
    "remote",
    "typescript"
  ],
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "author": "Patrick Glenn <doeixd@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doeixd/foldkit-plus.git",
    "directory": "packages/crud"
  },
  "homepage": "https://github.com/doeixd/foldkit-plus/tree/main/packages/crud#readme",
  "bugs": {
    "url": "https://github.com/doeixd/foldkit-plus/issues"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "foldkit-bundle": "workspace:*",
    "foldkit-entity": "workspace:*",
    "foldkit-form": "workspace:*",
    "foldkit-metadata": "workspace:*",
    "foldkit-remote": "workspace:*",
    "foldkit-surface": "workspace:*"
  },
  "peerDependencies": {
    "effect": "^4.0.0-rc.116",
    "foldkit": "^0.163.0"
  },
  "devDependencies": {
    "@effect/platform-browser": "4.0.0-rc.116",
    "effect": "4.0.0-rc.116",
    "foldkit": "0.163.0",
    "tsdown": "^0.23.0",
    "typescript": "5.9.3"
  }
}
