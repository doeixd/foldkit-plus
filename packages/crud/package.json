{
  "name": "foldkit-crud",
  "version": "0.12.0",
  "description": "Create, read, update and delete screens for Foldkit Plus, assembled from a form, a Remote operation, and the Entity they share. Each capability is declared, never implied.",
  "keywords": [
    "foldkit",
    "effect",
    "crud",
    "admin",
    "form",
    "remote",
    "typescript"
  ],
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "author": "Patrick Glenn <doeixd@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doeixd/foldkit-plus.git",
    "directory": "packages/crud"
  },
  "homepage": "https://foldkit-plus.pages.dev/crud",
  "bugs": {
    "url": "https://github.com/doeixd/foldkit-plus/issues"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "foldkit-plus:source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "foldkit-bundle": "workspace:*",
    "foldkit-entity": "workspace:*",
    "foldkit-form": "workspace:*",
    "foldkit-metadata": "workspace:*",
    "foldkit-remote": "workspace:*",
    "foldkit-surface": "workspace:*"
  },
  "peerDependencies": {
    "effect": "^4.1.0",
    "foldkit": "^0.170.0"
  },
  "devDependencies": {
    "@effect/platform-browser": "^4.1.1",
    "effect": "^4.1.1",
    "foldkit": "0.170.0",
    "tsdown": "^0.23.1",
    "typescript": "7.0.2"
  }
}
