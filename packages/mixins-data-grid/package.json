  "description": "A foldkit-data-grid grid drawn as an accessible, virtualized WAI-ARIA grid through slots.",
  "keywords": [
    "foldkit",
    "data-grid",
    "mixins",
    "accessibility",
    "typescript"
  ],
  "type": "module",
  "license": "MIT",
