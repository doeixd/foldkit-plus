    "url": "git+https://github.com/doeixd/foldkit-plus.git",
    "directory": "packages/mixins-data-grid"
  },
  "homepage": "https://github.com/doeixd/foldkit-plus/tree/main/packages/mixins-data-grid#readme",
  "bugs": {
    "url": "https://github.com/doeixd/foldkit-plus/issues"
  },
