{
  "name": "foldkit-durable",
  "version": "0.10.0",
  "description": "A durable, ordered operation log with snapshots, cursors, idempotent append, compaction, and a durable effect ledger.",
  "keywords": [
    "foldkit",
    "effect",
    "durable",
    "journal",
    "operation-log",
    "sqlite"
  ],
  "type": "module",
  "license": "MIT",
  "author": "Patrick Glenn <doeixd@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doeixd/foldkit-plus.git",
    "directory": "packages/durable"
  },
  "homepage": "https://foldkit-plus.pages.dev/sync/guides/durable",
  "bugs": {
    "url": "https://github.com/doeixd/foldkit-plus/issues"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "foldkit-plus:source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "foldkit-plus:source": "./src/core.ts",
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -b"
  },
  "peerDependencies": {
    "effect": "^4.1.0"
  },
  "dependencies": {
    "@effect/sql-sqlite-node": "^4.1.0",
    "@noble/hashes": "^2.4.0"
  },
  "devDependencies": {
    "@effect/sql-d1": "^4.1.0",
    "@effect/sql-sqlite-wasm": "^4.1.0",
    "effect": "^4.1.0",
    "esbuild": "0.28.2",
    "miniflare": "4.20260730.0",
    "tsdown": "^0.23.1",
    "typescript": "7.0.2"
  }
}
