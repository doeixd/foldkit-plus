{
  "name": "foldkit-metadata",
  "version": "0.1.0",
  "description": "Opaque typed metadata for Foldkit Plus: each interpreter owns a key, its merge, and its summary.",
  "keywords": [
    "foldkit",
    "metadata",
    "typescript"
  ],
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "author": "Patrick Glenn <doeixd@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doeixd/foldkit-plus.git",
    "directory": "packages/metadata"
  },
  "homepage": "https://foldkit-plus.pages.dev/surface/guides/metadata",
  "bugs": {
    "url": "https://github.com/doeixd/foldkit-plus/issues"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "foldkit-plus:source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node ../../scripts/declarations.mjs . && tsdown && node ../../scripts/declared-any.mjs .",
    "typecheck": "tsc -b"
  },
  "peerDependencies": {
    "effect": "^4.1.0"
  },
  "devDependencies": {
    "effect": "4.1.4",
    "tsdown": "^0.23.1",
    "typescript": "7.0.2"
  }
}
