{
  "name": "foldkit-metadata",
  "version": "0.1.0",
  "description": "Opaque typed metadata for Foldkit Plus: each interpreter owns a key, its merge, and its summary.",
  "keywords": [
    "foldkit",
    "metadata",
    "typescript"
  ],
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "author": "Patrick Glenn <doeixd@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doeixd/foldkit-plus.git",
    "directory": "packages/metadata"
  },
  "homepage": "https://github.com/doeixd/foldkit-plus/tree/main/packages/metadata#readme",
  "bugs": {
    "url": "https://github.com/doeixd/foldkit-plus/issues"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "tsdown": "^0.23.0",
    "typescript": "5.9.3"
  }
}
