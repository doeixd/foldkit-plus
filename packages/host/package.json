{
  "name": "foldkit-host",
  "version": "0.2.0",
  "description": "The parts of a server's fetch handler for a Foldkit Plus application: values built once per isolate, the built page template, an ordered route table behind one configured origin, and a Node adapter for the same handler.",
  "keywords": [
    "foldkit",
    "cloudflare-workers",
    "server",
    "fetch",
    "routing"
  ],
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "author": "Patrick Glenn <doeixd@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doeixd/foldkit-plus.git",
    "directory": "packages/host"
  },
  "homepage": "https://foldkit-plus.pages.dev/ssr",
  "bugs": {
    "url": "https://github.com/doeixd/foldkit-plus/issues"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "foldkit-plus:source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node ../../scripts/declarations.mjs . && tsdown && node ../../scripts/declared-any.mjs .",
    "typecheck": "tsc -b"
  },
  "peerDependencies": {
    "foldkit": "^0.170.0"
  },
  "devDependencies": {
    "foldkit": "0.170.0",
    "tsdown": "^0.23.1",
    "typescript": "7.0.2"
  }
}
