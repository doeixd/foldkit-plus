{
  "name": "foldkit-cms",
  "version": "0.2.0",
  "description": "What a CMS adds to a Foldkit Plus domain: audience, time, and address. A draft is an unsent form kept beside the content row; state is derived, never stored. Headless.",
  "keywords": [
    "foldkit",
    "effect",
    "cms",
    "content",
    "drafts",
    "typescript"
  ],
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "author": "Patrick Glenn <doeixd@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doeixd/foldkit-plus.git",
    "directory": "packages/cms"
  },
  "homepage": "https://github.com/doeixd/foldkit-plus/tree/main/packages/cms#readme",
  "bugs": {
    "url": "https://github.com/doeixd/foldkit-plus/issues"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "foldkit-bundle": "workspace:*",
    "foldkit-crud": "workspace:*",
    "foldkit-entity": "workspace:*",
    "foldkit-form": "workspace:*",
    "foldkit-metadata": "workspace:*",
    "foldkit-remote": "workspace:*",
    "foldkit-surface": "workspace:*"
  },
  "peerDependencies": {
    "effect": "^4.0.0-rc.116",
    "foldkit": "^0.163.0"
  },
  "devDependencies": {
    "@effect/platform-browser": "4.0.0-rc.116",
    "effect": "4.0.0-rc.116",
    "foldkit": "0.163.0",
    "foldkit-mixins": "workspace:*",
    "foldkit-mixins-crud": "workspace:*",
    "foldkit-mixins-form": "workspace:*",
    "tsdown": "^0.23.0",
    "typescript": "5.9.3"
  }
}
