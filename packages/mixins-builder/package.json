{
  "name": "foldkit-mixins-builder",
  "version": "0.3.16",
  "description": "The page builder drawn as accessible HTML through foldkit-mixins slots: a palette, a keyboard-driven layers tree, an inspector, and the page in edit mode.",
  "keywords": [
    "foldkit",
    "page-builder",
    "mixins",
    "accessibility",
    "typescript"
  ],
  "type": "module",
  "license": "MIT",
  "author": "Patrick Glenn <doeixd@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doeixd/foldkit-plus.git",
    "directory": "packages/mixins-builder"
  },
  "homepage": "https://foldkit-plus.pages.dev/composition/guides/mixins-builder",
  "bugs": {
    "url": "https://github.com/doeixd/foldkit-plus/issues"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "foldkit-plus:source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -b"
  },
  "peerDependencies": {
    "effect": "^4.0.0",
    "foldkit": "^0.169.0"
  },
  "dependencies": {
    "foldkit-builder": "workspace:*",
    "foldkit-composition": "workspace:*",
    "foldkit-entity": "workspace:*",
    "foldkit-form": "workspace:*",
    "foldkit-mixins": "workspace:*",
    "foldkit-mixins-form": "workspace:*",
    "foldkit-primitives": "workspace:*"
  },
  "devDependencies": {
    "effect": "^4.0.5",
    "foldkit": "0.169.0",
    "foldkit-bundle": "workspace:*",
    "jsdom": "30.1.3",
    "tsdown": "^0.23.1",
    "typescript": "7.0.2"
  }
}
