{
  "name": "foldkit-richtext-dom",
  "version": "0.0.0",
  "private": true,
  "description": "The DOM interpreter for a foldkit-richtext editable subtree.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./events": {
      "types": "./dist/events.d.mts",
      "import": "./dist/events.mjs"
    },
    "./html": {
      "types": "./dist/html.d.mts",
      "import": "./dist/html.mjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "foldkit-richtext": "workspace:*"
  },
  "devDependencies": {
    "jsdom": "26.1.0",
    "tsdown": "^0.23.0",
    "typescript": "5.9.3"
  }
}
