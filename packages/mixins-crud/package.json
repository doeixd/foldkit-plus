{
  "name": "foldkit-mixins-crud",
  "version": "0.2.0",
  "description": "foldkit-crud lists and details drawn through foldkit-mixins slots: an accessible table and description list, styleable and extensible by contract.",
  "keywords": [
    "foldkit",
    "effect",
    "crud",
    "table",
    "mixins",
    "slots",
    "typescript"
  ],
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "author": "Patrick Glenn <doeixd@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doeixd/foldkit-plus.git",
    "directory": "packages/mixins-crud"
  },
  "homepage": "https://github.com/doeixd/foldkit-plus/tree/main/packages/mixins-crud#readme",
  "bugs": {
    "url": "https://github.com/doeixd/foldkit-plus/issues"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "foldkit-crud": "workspace:*",
    "foldkit-form": "workspace:*",
    "foldkit-mixins": "workspace:*",
    "foldkit-remote": "workspace:*"
  },
  "peerDependencies": {
    "effect": "^4.0.0-rc.112",
    "foldkit": "^0.158.2"
  },
  "devDependencies": {
    "effect": "4.0.0-rc.112",
    "foldkit": "0.158.2",
    "foldkit-entity": "workspace:*",
    "foldkit-surface": "workspace:*",
    "jsdom": "26.1.0",
    "tsdown": "^0.23.0",
    "typescript": "5.9.3"
  }
}
