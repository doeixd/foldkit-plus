{
  "name": "foldkit-mixins-crud",
  "version": "0.10.0",
  "description": "foldkit-crud lists and details drawn through foldkit-mixins slots: an accessible table and description list, styleable and extensible by contract.",
  "keywords": [
    "foldkit",
    "effect",
    "crud",
    "table",
    "mixins",
    "slots",
    "typescript"
  ],
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "author": "Patrick Glenn <doeixd@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doeixd/foldkit-plus.git",
    "directory": "packages/mixins-crud"
  },
  "homepage": "https://foldkit-plus.pages.dev/crud/guides/mixins-crud",
  "bugs": {
    "url": "https://github.com/doeixd/foldkit-plus/issues"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "foldkit-plus:source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./recipes": {
      "foldkit-plus:source": "./src/recipes.ts",
      "types": "./dist/recipes.d.ts",
      "import": "./dist/recipes.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "foldkit-crud": "workspace:*",
    "foldkit-form": "workspace:*",
    "foldkit-mixins": "workspace:*",
    "foldkit-remote": "workspace:*"
  },
  "peerDependencies": {
    "effect": "^4.1.0",
    "foldkit": "^0.170.0"
  },
  "devDependencies": {
    "@effect/platform-browser": "^4.1.0",
    "@foldkit/ui": "0.170.0",
    "effect": "^4.1.0",
    "foldkit": "0.170.0",
    "foldkit-entity": "workspace:*",
    "foldkit-mixins-form": "workspace:*",
    "foldkit-mixins-ui": "workspace:*",
    "foldkit-surface": "workspace:*",
    "jsdom": "30.1.3",
    "tsdown": "^0.23.1",
    "typescript": "7.0.2"
  }
}
