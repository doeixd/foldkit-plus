{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": ".tsbuild",
    "emitDeclarationOnly": true,
    "composite": true,
    "noEmit": false,
    "paths": {
      "foldkit-bundle": ["../bundle/src/index.ts"],
      "foldkit-entity": ["../entity/src/index.ts"],
      "foldkit-entity/conformance": ["../entity/src/conformance/index.ts"],
      "foldkit-entity/lowering": ["../entity/src/lowering.ts"],
      "foldkit-form": ["../form/src/index.ts"],
      "foldkit-form/metakit": ["../form/src/metakit.ts"],
      "foldkit-metadata": ["../metadata/src/index.ts"],
      "foldkit-mixins": ["../mixins/src/index.ts"],
      "foldkit-mixins-form": ["./src/index.ts"],
      "foldkit-mixins-form/declared": ["./src/declared.ts"],
      "foldkit-mixins-form/recipes": ["./src/recipes.ts"],
      "foldkit-mixins-form/ui": ["./src/ui.ts"],
      "foldkit-mixins-ui": ["../mixins-ui/src/index.ts"],
      "foldkit-mixins/app": ["../mixins/src/app.ts"],
      "foldkit-mixins/defaults": ["../mixins/src/defaults.ts"],
      "foldkit-mixins/foundations": ["../mixins/src/foundations.ts"],
      "foldkit-mixins/layers": ["../mixins/src/layers.ts"],
      "foldkit-mixins/layout": ["../mixins/src/layout.ts"],
      "foldkit-mixins/prose": ["../mixins/src/prose.ts"],
      "foldkit-mixins/testing": ["../mixins/src/testing.ts"],
      "foldkit-mixins/theme": ["../mixins/src/theme.ts"],
      "foldkit-mixins/theme/knob-data": ["../mixins/src/theme/knobData.ts"],
      "foldkit-mixins/theme/runtime": ["../mixins/src/theme/runtime.ts"],
      "foldkit-mixins/utilities": ["../mixins/src/utilities.ts"],
      "foldkit-mixins/vite": ["../mixins/src/vite.ts"],
      "metakit": ["../metakit/src/index.ts"],
      "metakit/aggregates": ["../metakit/src/aggregates.ts"],
      "metakit/aggregates/sql": ["../metakit/src/aggregatesSql.ts"],
      "metakit/build": ["../metakit/src/build.ts"],
      "metakit/conformance": ["../metakit/src/conformance.ts"],
      "metakit/domain": ["../metakit/src/domain.ts"],
      "metakit/drizzle": ["../metakit/src/drizzle.ts"],
      "metakit/graph": ["../metakit/src/graph.ts"],
      "metakit/graph/match": ["../metakit/src/graph/match.ts"],
      "metakit/graph/prune": ["../metakit/src/graph/prune.ts"],
      "metakit/graph/readiness": ["../metakit/src/graph/readiness.ts"],
      "metakit/inspect": ["../metakit/src/inspect.ts"],
      "metakit/machine": ["../metakit/src/machine.ts"],
      "metakit/policy": ["../metakit/src/policy.ts"],
      "metakit/prove": ["../metakit/src/prove.ts"],
      "metakit/relation": ["../metakit/src/relation.ts"],
      "metakit/sql": ["../metakit/src/sql.ts"],
      "metakit/store": ["../metakit/src/store.ts"],
      "metakit/temporal": ["../metakit/src/temporal.ts"]
    }
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "tsdown.config.ts"],
  "references": [
    {
      "path": "../mixins-ui/tsconfig.build.json"
    },
    {
      "path": "../bundle/tsconfig.build.json"
    },
    {
      "path": "../entity/tsconfig.build.json"
    },
    {
      "path": "../form/tsconfig.build.json"
    },
    {
      "path": "../metadata/tsconfig.build.json"
    },
    {
      "path": "../metakit/tsconfig.build.json"
    },
    {
      "path": "../mixins/tsconfig.build.json"
    }
  ]
}
