{
  "name": "foldkit-mixins-form",
  "version": "0.6.2",
  "description": "A foldkit-form form drawn through foldkit-mixins slots: styleable, extensible, and accessible by contract.",
  "keywords": [
    "foldkit",
    "effect",
    "form",
    "mixins",
    "slots",
    "typescript"
  ],
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "author": "Patrick Glenn <doeixd@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doeixd/foldkit-plus.git",
    "directory": "packages/mixins-form"
  },
  "homepage": "https://foldkit-plus.pages.dev/form/guides/mixins-form",
  "bugs": {
    "url": "https://github.com/doeixd/foldkit-plus/issues"
  },
  "sideEffects": false,
  "exports": {
    "./ui": {
      "foldkit-plus:source": "./src/ui.ts",
      "types": "./dist/ui.d.mts",
      "import": "./dist/ui.mjs"
    },
    ".": {
      "foldkit-plus:source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "foldkit-bundle": "workspace:*",
    "foldkit-form": "workspace:*",
    "foldkit-mixins": "workspace:*"
  },
  "peerDependencies": {
    "effect": "^4.0.0",
    "foldkit": "^0.168.0",
    "foldkit-mixins-ui": "workspace:*"
  },
  "peerDependenciesMeta": {
    "foldkit-mixins-ui": {
      "optional": true
    }
  },
  "devDependencies": {
    "@effect/platform-browser": "^4.0.4",
    "effect": "^4.0.4",
    "foldkit": "0.168.0",
    "foldkit-entity": "workspace:*",
    "foldkit-mixins-ui": "workspace:*",
    "jsdom": "30.1.2",
    "tsdown": "^0.23.1",
    "typescript": "7.0.2"
  }
}
