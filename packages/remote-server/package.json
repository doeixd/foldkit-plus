{
  "name": "foldkit-remote-server",
  "version": "0.15.1",
  "description": "Server sources and handler compilation for foldkit-remote: entities, selection authorization, and normalization.",
  "keywords": [
    "foldkit",
    "effect",
    "server-state",
    "rpc",
    "authorization",
    "normalization"
  ],
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "author": "Patrick Glenn <doeixd@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doeixd/foldkit-plus.git",
    "directory": "packages/remote-server"
  },
  "homepage": "https://foldkit-plus.pages.dev/remote/guides/remote-server",
  "bugs": {
    "url": "https://github.com/doeixd/foldkit-plus/issues"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "foldkit-plus:source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./port": {
      "foldkit-plus:source": "./src/port.ts",
      "types": "./dist/port.d.mts",
      "import": "./dist/port.mjs"
    },
    "./fetch": {
      "foldkit-plus:source": "./src/fetch.ts",
      "types": "./dist/fetch.d.mts",
      "import": "./dist/fetch.mjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "foldkit-entity": "workspace:*",
    "foldkit-remote": "workspace:*"
  },
  "peerDependencies": {
    "effect": "^4.0.0"
  },
  "devDependencies": {
    "@effect/platform-browser": "^4.0.5",
    "effect": "^4.0.5",
    "foldkit": "0.169.0",
    "foldkit-surface": "workspace:*",
    "tsdown": "^0.23.1",
    "typescript": "7.0.2"
  }
}
