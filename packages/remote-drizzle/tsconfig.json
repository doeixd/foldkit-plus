{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": ".tsbuild",
    "emitDeclarationOnly": true,
    "composite": true,
    "noEmit": false,
    "paths": {
      "foldkit-entity": ["../entity/src/index.ts"],
      "foldkit-entity/conformance": ["../entity/src/conformance/index.ts"],
      "foldkit-entity/laws": ["../entity/src/laws.ts"],
      "foldkit-entity/lowering": ["../entity/src/lowering.ts"],
      "foldkit-entity/transition": ["../entity/src/writeTransition.ts"],
      "foldkit-metadata": ["../metadata/src/index.ts"],
      "foldkit-remote": ["../remote/src/index.ts"],
      "foldkit-remote-drizzle": ["./src/index.ts"],
      "foldkit-remote-drizzle/pg": ["./src/pg.ts"],
      "foldkit-remote-server": ["../remote-server/src/index.ts"],
      "foldkit-remote-server/fetch": ["../remote-server/src/fetch.ts"],
      "foldkit-remote-server/port": ["../remote-server/src/port.ts"],
      "foldkit-remote/aggregate": ["../remote/src/aggregate.ts"],
      "foldkit-remote/filter": ["../remote/src/filter.ts"],
      "foldkit-remote/live": ["../remote/src/live.ts"],
      "foldkit-remote/outbox": ["../remote/src/outbox.ts"],
      "foldkit-remote/overlay": ["../remote/src/overlay.ts"],
      "foldkit-remote/persistence": ["../remote/src/persistence.ts"],
      "foldkit-remote/port": ["../remote/src/port.ts"],
      "foldkit-remote/testing": ["../remote/src/testing.ts"],
      "foldkit-remote/why": ["../remote/src/why.ts"],
      "foldkit-surface": ["../surface/src/index.ts"],
      "foldkit-surface/declared": ["../surface/src/declared.ts"],
      "foldkit-surface/writes": ["../surface/src/writes.ts"],
      "metakit": ["../metakit/src/index.ts"],
      "metakit/aggregates": ["../metakit/src/aggregates.ts"],
      "metakit/aggregates/sql": ["../metakit/src/aggregatesSql.ts"],
      "metakit/build": ["../metakit/src/build.ts"],
      "metakit/conformance": ["../metakit/src/conformance.ts"],
      "metakit/domain": ["../metakit/src/domain.ts"],
      "metakit/drizzle": ["../metakit/src/drizzle.ts"],
      "metakit/graph": ["../metakit/src/graph.ts"],
      "metakit/graph/match": ["../metakit/src/graph/match.ts"],
      "metakit/graph/prune": ["../metakit/src/graph/prune.ts"],
      "metakit/graph/readiness": ["../metakit/src/graph/readiness.ts"],
      "metakit/inspect": ["../metakit/src/inspect.ts"],
      "metakit/machine": ["../metakit/src/machine.ts"],
      "metakit/pairs": ["../metakit/src/pairs.ts"],
      "metakit/policy": ["../metakit/src/policy.ts"],
      "metakit/prove": ["../metakit/src/prove.ts"],
      "metakit/relation": ["../metakit/src/relation.ts"],
      "metakit/sql": ["../metakit/src/sql.ts"],
      "metakit/store": ["../metakit/src/store.ts"],
      "metakit/temporal": ["../metakit/src/temporal.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "bench/**/*.ts",
    "example/**/*.ts",
    "tsdown.config.ts"
  ],
  "references": [
    {
      "path": "../entity/tsconfig.build.json"
    },
    {
      "path": "../metadata/tsconfig.build.json"
    },
    {
      "path": "../remote/tsconfig.build.json"
    },
    {
      "path": "../remote-server/tsconfig.build.json"
    },
    {
      "path": "../surface/tsconfig.build.json"
    },
    {
      "path": "../metakit/tsconfig.build.json"
    }
  ]
}
