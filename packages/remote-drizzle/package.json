{
  "name": "foldkit-remote-drizzle",
  "version": "0.16.0",
  "description": "Provisional compiler from Remote Entity/Selection/Query to Drizzle's typed query graph.",
  "keywords": [
    "foldkit",
    "effect",
    "drizzle",
    "drizzle-orm",
    "sql",
    "server-state"
  ],
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "author": "Patrick Glenn <doeixd@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doeixd/foldkit-plus.git",
    "directory": "packages/remote-drizzle"
  },
  "homepage": "https://foldkit-plus.pages.dev/remote/guides/remote-drizzle",
  "bugs": {
    "url": "https://github.com/doeixd/foldkit-plus/issues"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "foldkit-plus:source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "foldkit-entity": "workspace:*",
    "foldkit-remote": "workspace:*",
    "foldkit-remote-server": "workspace:*"
  },
  "peerDependencies": {
    "drizzle-orm": "1.0.0-rc.5",
    "effect": "^4.1.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.11",
    "drizzle-orm": "1.0.0-rc.5",
    "effect": "^4.1.0",
    "foldkit": "0.170.0",
    "foldkit-remote-server": "workspace:*",
    "foldkit-surface": "workspace:*",
    "miniflare": "4.20260730.0",
    "tsdown": "^0.23.1",
    "typescript": "7.0.2"
  }
}
