{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": ".tsbuild",
    "emitDeclarationOnly": true,
    "composite": true,
    "noEmit": false,
    "paths": {
      "foldkit-bundle": ["../bundle/src/index.ts"],
      "foldkit-mixins": ["../mixins/src/index.ts"],
      "foldkit-mixins/app": ["../mixins/src/app.ts"],
      "foldkit-mixins/defaults": ["../mixins/src/defaults.ts"],
      "foldkit-mixins/foundations": ["../mixins/src/foundations.ts"],
      "foldkit-mixins/layers": ["../mixins/src/layers.ts"],
      "foldkit-mixins/layout": ["../mixins/src/layout.ts"],
      "foldkit-mixins/prose": ["../mixins/src/prose.ts"],
      "foldkit-mixins/testing": ["../mixins/src/testing.ts"],
      "foldkit-mixins/theme": ["../mixins/src/theme.ts"],
      "foldkit-mixins/utilities": ["../mixins/src/utilities.ts"],
      "foldkit-primitives": ["./src/index.ts"],
      "foldkit-primitives/device": ["./src/device/index.ts"],
      "foldkit-primitives/dom": ["./src/dom/index.ts"],
      "foldkit-primitives/events": ["./src/events/index.ts"],
      "foldkit-primitives/interaction": ["./src/interaction/index.ts"],
      "foldkit-primitives/media": ["./src/media/index.ts"],
      "foldkit-primitives/motion": ["./src/motion/index.ts"],
      "foldkit-primitives/net": ["./src/net/index.ts"],
      "foldkit-primitives/observers": ["./src/observers/index.ts"],
      "foldkit-primitives/state": ["./src/state/index.ts"],
      "foldkit-primitives/time": ["./src/time/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "tsdown.config.ts"],
  "references": [
    {
      "path": "../bundle/tsconfig.build.json"
    },
    {
      "path": "../mixins/tsconfig.build.json"
    }
  ]
}
