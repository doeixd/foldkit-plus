{
  "name": "foldkit-plus-workspace",
  "private": true,
  "license": "MIT",
  "author": "Patrick Glenn <doeixd@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doeixd/foldkit-plus.git"
  },
  "homepage": "https://foldkit-plus.pages.dev",
  "bugs": {
    "url": "https://github.com/doeixd/foldkit-plus/issues"
  },
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/declarations.mjs && pnpm -r build",
    "build:packages": "node scripts/declarations.mjs && pnpm -r --filter \"./packages/*\" build",
    "test": "vitest run",
    "e2e": "vitest run --config vitest.e2e.config.ts",
    "bench": "vitest bench --run",
    "mutate": "tsx scripts/mutate.mjs",
    "mutate:check": "tsx scripts/mutate.mjs --check",
    "bench:storage": "tsx packages/durable/bench/storage.ts",
    "bench:manifest": "tsx --tsconfig packages/ssr/tsconfig.json packages/ssr/bench/manifest.ts",
    "bench:manifest:browser": "tsx --tsconfig packages/ssr/tsconfig.json packages/ssr/bench/manifestBrowser.ts",
    "demo": "pnpm build && pnpm --filter foldkit-example-todo demo && pnpm --filter foldkit-example-sync demo && pnpm --filter foldkit-example-mixins demo && pnpm --filter foldkit-example-bundle demo && pnpm --filter foldkit-example-react demo && pnpm --filter foldkit-example-remote demo && pnpm --filter foldkit-example-entity demo && pnpm --filter foldkit-example-fields demo && pnpm --filter foldkit-example-writes demo && pnpm exec tsx packages/remote-drizzle/example/nested.ts && pnpm --filter foldkit-example-kitchen-sink demo && pnpm --filter foldkit-example-todo-app demo && pnpm --filter foldkit-example-pages demo",
    "test:watch": "vitest",
    "paths": "node scripts/workspace-paths.mjs",
    "paths:check": "node scripts/workspace-paths.mjs --check",
    "icons": "tsx scripts/icons.mjs",
    "icons:check": "tsx scripts/icons.mjs --check",
    "tags:check": "node scripts/tags-check.mjs",
    "typecheck": "tsc -b",
    "typecheck:force": "tsc -b --force",
    "check": "pnpm format:check && pnpm paths:check && pnpm icons:check && pnpm tags:check && pnpm mutate:check && pnpm typecheck && pnpm test && pnpm demo && pnpm pack:check",
    "format": "oxfmt --write \"**/*.{ts,json,yaml}\"",
    "format:check": "oxfmt --check \"**/*.{ts,json,yaml}\"",
    "pack:check": "pnpm build:packages && node scripts/published-types.mjs && pnpm -r --filter \"./packages/*\" exec pnpm pack && node scripts/published-setup.mjs",
    "release": "pnpm build:packages && pnpm -r --filter \"./packages/*\" publish --access public --no-git-checks"
  },
  "devDependencies": {
    "@effect/language-service": "^0.87.5",
    "@effect/platform-browser": "^4.0.5",
    "@effect/sql-pg": "^4.0.5",
    "@iconify-json/heroicons": "^1.2.3",
    "@iconify-json/hugeicons": "^1.2.35",
    "@iconify-json/lucide": "^1.2.147",
    "@iconify-json/ph": "^1.2.2",
    "@iconify-json/tabler": "^1.2.42",
    "@types/node": "^22.20.5",
    "@vitest/browser-playwright": "5.0.5",
    "drizzle-orm": "1.0.0-rc.5",
    "effect": "^4.0.5",
    "foldkit": "0.169.0",
    "oxfmt": "0.74.0",
    "playwright": "^1.64.1",
    "tsdown": "^0.23.1",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "typescript-6": "npm:typescript@6.0.3",
    "unrun": "^0.3.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
