{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": ".tsbuild",
    "emitDeclarationOnly": true,
    "composite": true,
    "noEmit": false,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"],
    "paths": {
      "foldkit-agent": ["../../packages/agent/src/index.ts"],
      "foldkit-agent/metakit": ["../../packages/agent/src/metakit.ts"],
      "foldkit-bundle": ["../../packages/bundle/src/index.ts"],
      "foldkit-mixins": ["../../packages/mixins/src/index.ts"],
      "foldkit-mixins/app": ["../../packages/mixins/src/app.ts"],
      "foldkit-mixins/defaults": ["../../packages/mixins/src/defaults.ts"],
      "foldkit-mixins/foundations": ["../../packages/mixins/src/foundations.ts"],
      "foldkit-mixins/layers": ["../../packages/mixins/src/layers.ts"],
      "foldkit-mixins/layout": ["../../packages/mixins/src/layout.ts"],
      "foldkit-mixins/prose": ["../../packages/mixins/src/prose.ts"],
      "foldkit-mixins/testing": ["../../packages/mixins/src/testing.ts"],
      "foldkit-mixins/theme": ["../../packages/mixins/src/theme.ts"],
      "foldkit-mixins/theme/knob-data": ["../../packages/mixins/src/theme/knobData.ts"],
      "foldkit-mixins/theme/runtime": ["../../packages/mixins/src/theme/runtime.ts"],
      "foldkit-mixins/utilities": ["../../packages/mixins/src/utilities.ts"],
      "foldkit-mixins/vite": ["../../packages/mixins/src/vite.ts"],
      "foldkit-primitives": ["../../packages/primitives/src/index.ts"],
      "foldkit-primitives/device": ["../../packages/primitives/src/device/index.ts"],
      "foldkit-primitives/dom": ["../../packages/primitives/src/dom/index.ts"],
      "foldkit-primitives/events": ["../../packages/primitives/src/events/index.ts"],
      "foldkit-primitives/interaction": ["../../packages/primitives/src/interaction/index.ts"],
      "foldkit-primitives/media": ["../../packages/primitives/src/media/index.ts"],
      "foldkit-primitives/motion": ["../../packages/primitives/src/motion/index.ts"],
      "foldkit-primitives/net": ["../../packages/primitives/src/net/index.ts"],
      "foldkit-primitives/observers": ["../../packages/primitives/src/observers/index.ts"],
      "foldkit-primitives/state": ["../../packages/primitives/src/state/index.ts"],
      "foldkit-primitives/time": ["../../packages/primitives/src/time/index.ts"],
      "foldkit-remote": ["../../packages/remote/src/index.ts"],
      "foldkit-remote/filter": ["../../packages/remote/src/filter.ts"],
      "foldkit-remote/live": ["../../packages/remote/src/live.ts"],
      "foldkit-remote/maintained": ["../../packages/remote/src/maintained/index.ts"],
      "foldkit-remote/outbox": ["../../packages/remote/src/outbox.ts"],
      "foldkit-remote/overlay": ["../../packages/remote/src/overlay.ts"],
      "foldkit-remote/persistence": ["../../packages/remote/src/persistence.ts"],
      "foldkit-remote/port": ["../../packages/remote/src/port.ts"],
      "foldkit-remote/testing": ["../../packages/remote/src/testing.ts"],
      "foldkit-remote/why": ["../../packages/remote/src/why.ts"],
      "foldkit-surface": ["../../packages/surface/src/index.ts"],
      "foldkit-surface/declared": ["../../packages/surface/src/declared.ts"],
      "foldkit-surface/writes": ["../../packages/surface/src/writes.ts"]
    }
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "vite.config.ts"],
  "references": [
    {
      "path": "../../packages/agent/tsconfig.build.json"
    },
    {
      "path": "../../packages/bundle/tsconfig.build.json"
    },
    {
      "path": "../../packages/mixins/tsconfig.build.json"
    },
    {
      "path": "../../packages/primitives/tsconfig.build.json"
    },
    {
      "path": "../../packages/remote/tsconfig.build.json"
    },
    {
      "path": "../../packages/surface/tsconfig.build.json"
    }
  ]
