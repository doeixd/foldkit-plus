{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": ".tsbuild",
    "emitDeclarationOnly": true,
    "composite": true,
    "types": ["node", "vite/client"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "paths": {
      "foldkit-bundle": ["../../packages/bundle/src/index.ts"],
      "foldkit-durable": ["../../packages/durable/src/index.ts"],
      "foldkit-durable/core": ["../../packages/durable/src/core.ts"],
      "foldkit-example-site/demos": ["../site/src/demos.ts"],
      "foldkit-example-site/intro": ["../site/src/intro.ts"],
      "foldkit-metadata": ["../../packages/metadata/src/index.ts"],
      "foldkit-primitives": ["../../packages/primitives/src/index.ts"],
      "foldkit-primitives/device": ["../../packages/primitives/src/device/index.ts"],
      "foldkit-primitives/dom": ["../../packages/primitives/src/dom/index.ts"],
      "foldkit-primitives/events": ["../../packages/primitives/src/events/index.ts"],
      "foldkit-primitives/interaction": ["../../packages/primitives/src/interaction/index.ts"],
      "foldkit-primitives/media": ["../../packages/primitives/src/media/index.ts"],
      "foldkit-primitives/motion": ["../../packages/primitives/src/motion/index.ts"],
      "foldkit-primitives/net": ["../../packages/primitives/src/net/index.ts"],
      "foldkit-primitives/observers": ["../../packages/primitives/src/observers/index.ts"],
      "foldkit-primitives/state": ["../../packages/primitives/src/state/index.ts"],
      "foldkit-primitives/time": ["../../packages/primitives/src/time/index.ts"],
      "foldkit-richtext": ["../../packages/richtext/src/index.ts"],
      "foldkit-richtext-dom": ["../../packages/richtext-dom/src/index.ts"],
      "foldkit-richtext-dom/editor": ["../../packages/richtext-dom/src/editor.ts"],
      "foldkit-richtext-dom/editor-bundle": ["../../packages/richtext-dom/src/editor-bundle.ts"],
      "foldkit-richtext-dom/events": ["../../packages/richtext-dom/src/events.ts"],
      "foldkit-richtext-dom/host": ["../../packages/richtext-dom/src/host.ts"],
      "foldkit-richtext-dom/html": ["../../packages/richtext-dom/src/html.ts"],
      "foldkit-richtext-dom/input": ["../../packages/richtext-dom/src/input.ts"],
      "foldkit-richtext-dom/toolbar": ["../../packages/richtext-dom/src/toolbar.ts"],
      "foldkit-richtext-dom/view": ["../../packages/richtext-dom/src/view.ts"],
      "foldkit-richtext-markdown": ["../../packages/richtext-markdown/src/index.ts"],
      "foldkit-surface": ["../../packages/surface/src/index.ts"],
      "foldkit-sync": ["../../packages/sync/src/index.ts"],
      "foldkit-sync/entity": ["../../packages/sync/src/entity.ts"],
      "foldkit-sync/journal": ["../../packages/sync/src/journal.ts"]
    }
  },
  "include": ["e2e/**/*.ts", "src/**/*.ts", "test/**/*.ts", "vite.config.ts"],
  "references": [
    {
      "path": "../site/tsconfig.json"
    },
    {
      "path": "../../packages/durable/tsconfig.build.json"
    },
    {
      "path": "../../packages/metadata/tsconfig.build.json"
    },
    {
      "path": "../../packages/primitives/tsconfig.build.json"
    },
    {
      "path": "../../packages/richtext/tsconfig.build.json"
    },
    {
      "path": "../../packages/richtext-dom/tsconfig.build.json"
    },
    {
      "path": "../../packages/richtext-markdown/tsconfig.build.json"
    },
    {
      "path": "../../packages/surface/tsconfig.build.json"
    },
    {
      "path": "../../packages/sync/tsconfig.build.json"
    },
    {
      "path": "../../packages/bundle/tsconfig.build.json"
    }
  ]
}
