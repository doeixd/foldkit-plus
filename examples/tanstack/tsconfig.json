{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": ".tsbuild",
    "emitDeclarationOnly": true,
    "composite": true,
    "noEmit": false,
    "paths": {
      "foldkit-entity": ["../../packages/entity/src/index.ts"],
      "foldkit-entity/conformance": ["../../packages/entity/src/conformance/index.ts"],
      "foldkit-metadata": ["../../packages/metadata/src/index.ts"],
      "foldkit-remote": ["../../packages/remote/src/index.ts"],
      "foldkit-remote-server": ["../../packages/remote-server/src/index.ts"],
      "foldkit-remote-server/fetch": ["../../packages/remote-server/src/fetch.ts"],
      "foldkit-remote-server/port": ["../../packages/remote-server/src/port.ts"],
      "foldkit-remote/aggregate": ["../../packages/remote/src/aggregate.ts"],
      "foldkit-remote/filter": ["../../packages/remote/src/filter.ts"],
      "foldkit-remote/live": ["../../packages/remote/src/live.ts"],
      "foldkit-remote/outbox": ["../../packages/remote/src/outbox.ts"],
      "foldkit-remote/overlay": ["../../packages/remote/src/overlay.ts"],
      "foldkit-remote/persistence": ["../../packages/remote/src/persistence.ts"],
      "foldkit-remote/port": ["../../packages/remote/src/port.ts"],
      "foldkit-remote/testing": ["../../packages/remote/src/testing.ts"],
      "foldkit-remote/why": ["../../packages/remote/src/why.ts"],
      "foldkit-surface": ["../../packages/surface/src/index.ts"],
      "foldkit-surface/writes": ["../../packages/surface/src/writes.ts"],
      "metakit": ["../../packages/metakit/src/index.ts"],
      "metakit/aggregates": ["../../packages/metakit/src/aggregates.ts"],
      "metakit/aggregates/sql": ["../../packages/metakit/src/aggregatesSql.ts"],
      "metakit/conformance": ["../../packages/metakit/src/conformance.ts"],
      "metakit/domain": ["../../packages/metakit/src/domain.ts"],
      "metakit/drizzle": ["../../packages/metakit/src/drizzle.ts"],
      "metakit/graph": ["../../packages/metakit/src/graph.ts"],
      "metakit/inspect": ["../../packages/metakit/src/inspect.ts"],
      "metakit/machine": ["../../packages/metakit/src/machine.ts"],
      "metakit/policy": ["../../packages/metakit/src/policy.ts"],
      "metakit/prove": ["../../packages/metakit/src/prove.ts"],
      "metakit/sql": ["../../packages/metakit/src/sql.ts"],
      "metakit/store": ["../../packages/metakit/src/store.ts"],
      "metakit/temporal": ["../../packages/metakit/src/temporal.ts"]
    }
  },
  "include": ["src/**/*.ts", "test/**/*.ts"],
  "references": [
    {
      "path": "../../packages/entity/tsconfig.build.json"
    },
    {
      "path": "../../packages/metadata/tsconfig.build.json"
    },
    {
      "path": "../../packages/remote/tsconfig.build.json"
    },
    {
      "path": "../../packages/remote-server/tsconfig.build.json"
    },
    {
      "path": "../../packages/surface/tsconfig.build.json"
    },
    {
      "path": "../../packages/metakit/tsconfig.build.json"
    }
  ]
}
