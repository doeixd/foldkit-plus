      "metakit/interpreter": ["../../packages/metakit/src/interpreter.ts"],
      "metakit/language": ["../../packages/metakit/src/language.ts"],
      "metakit/machine": ["../../packages/metakit/src/machine.ts"],
      "metakit/operation": ["../../packages/metakit/src/operation.ts"],
