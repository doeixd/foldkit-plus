    },
    {
      "path": "../../packages/auth/tsconfig.build.json"
    },
    {
      "path": "../../packages/primitives/tsconfig.build.json"
    },
    {
      "path": "../../packages/bundle/tsconfig.build.json"
    },
    {
      "path": "../../packages/site/tsconfig.build.json"
    },
    {
      "path": "../../packages/ssr/tsconfig.build.json"
    },
    {
      "path": "../../packages/durable/tsconfig.build.json"
    },
