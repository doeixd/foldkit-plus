{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": ".tsbuild",
    "emitDeclarationOnly": true,
    "composite": true,
    "noEmit": false,
    "paths": {
      "metakit": ["../../packages/metakit/src/index.ts"],
      "metakit/aggregates": ["../../packages/metakit/src/aggregates.ts"],
      "metakit/conformance": ["../../packages/metakit/src/conformance.ts"],
      "metakit/domain": ["../../packages/metakit/src/domain.ts"],
      "metakit/drizzle": ["../../packages/metakit/src/drizzle.ts"],
      "metakit/graph": ["../../packages/metakit/src/graph.ts"],
      "metakit/inspect": ["../../packages/metakit/src/inspect.ts"],
      "metakit/machine": ["../../packages/metakit/src/machine.ts"],
      "metakit/prove": ["../../packages/metakit/src/prove.ts"],
      "metakit/sql": ["../../packages/metakit/src/sql.ts"]
    }
  },
  "include": ["src/**/*.ts", "test/**/*.ts"],
  "references": [
    {
      "path": "../../packages/metakit/tsconfig.build.json"
    }
  ]
}
