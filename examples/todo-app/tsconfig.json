{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": ".tsbuild",
    "emitDeclarationOnly": true,
    "composite": true,
    "paths": {
      "foldkit-agent": ["../../packages/agent/src/index.ts"],
      "foldkit-agent-webmcp": ["../../packages/agent-webmcp/src/index.ts"],
      "foldkit-bundle": ["../../packages/bundle/src/index.ts"],
      "foldkit-durable": ["../../packages/durable/src/index.ts"],
      "foldkit-metadata": ["../../packages/metadata/src/index.ts"],
      "foldkit-mirror": ["../../packages/mirror/src/index.ts"],
      "foldkit-mixins": ["../../packages/mixins/src/index.ts"],
      "foldkit-mixins-surface": ["../../packages/mixins-surface/src/index.ts"],
      "foldkit-mixins-ui": ["../../packages/mixins-ui/src/index.ts"],
      "foldkit-surface": ["../../packages/surface/src/index.ts"],
      "foldkit-sync": ["../../packages/sync/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "test/**/*.ts"],
  "references": [
    {
      "path": "../../packages/agent-webmcp/tsconfig.build.json"
    },
    {
      "path": "../../packages/agent/tsconfig.build.json"
    },
    {
